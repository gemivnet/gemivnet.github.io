<div class="musings-layout">
  <%~ include('_rail', { copy: copy, rail: rail, escapeHtml: escapeHtml }) %>

  <div class="musings-main">
    <header class="sp-page-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">~</a><span class="sep">/</span><a href="/recipes"><%= copy.recipes.post.crumbs_root %></a><span class="sep">/</span><span class="here"><%= copy.recipes.category.kind %></span>
      </nav>
      <h1><%= escapeHtml(category.name) %></h1>
    </header>

    <%~ include('_entries', { copy: copy, entries: entries, listCopy: listCopy, section: { base: '/recipes' }, escapeHtml: escapeHtml, layout: 'compact' }) %>

    <%~ include('_recipe-disclaimer', { copy: copy }) %>

    <div class="sp-backlink">
      <a href="/recipes"><%= copy.recipes.post.back_label %></a>
    </div>
  </div>
</div>
