<header class="sp-page-head">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">~</a><% breadcrumbs.forEach(function(b, i){ %><span class="sep">/</span><% if (i === breadcrumbs.length - 1) { %><span class="here" aria-current="page"><%= b.label %></span><% } else { %><a href="<%= b.url %>"><%= b.label %></a><% } %><% }) %>
  </nav>
  <h1><%= node.title %></h1>
  <% if (node.subtitle) { %><p class="subtitle"><%= node.subtitle %></p><% } %>
  <% if (node.fromPost) { %>
    <p class="from-post">↩ from the <%= node.fromPost.label || 'musing' %>: <a href="<%= node.fromPost.url %>"><%= node.fromPost.title %></a></p>
  <% } %>
  <p class="meta">
    <% if (node.location) { %><span><%= node.location %></span><span class="sep">·</span><% } %>
    <% if (node.date) { %><span><%= fmtFull(node.date) %></span><span class="sep">·</span><% } %>
    <span><%= allDescendantImages.length %> photos<% if (subAlbums.length) { %> · <%= subAlbums.length %> sub-albums<% } %></span>
  </p>
</header>

<% if (subAlbums.length) { %>
  <div class="gallery-view">
    <input type="radio" name="gv-<%= node.dir.replace(/[^a-z0-9]/gi,'-') %>" id="gv-folder" value="folder" checked>
    <input type="radio" name="gv-<%= node.dir.replace(/[^a-z0-9]/gi,'-') %>" id="gv-grid"   value="grid">
    <input type="radio" name="gv-<%= node.dir.replace(/[^a-z0-9]/gi,'-') %>" id="gv-feed"   value="feed">

    <div class="gv-toggle" role="tablist" aria-label="Gallery view mode">
      <label for="gv-folder" data-view="folder">folders</label>
      <label for="gv-grid"   data-view="grid">grid</label>
      <label for="gv-feed"   data-view="feed">feed</label>
    </div>

    <!-- folder view: sub-albums above, loose photos below -->
    <div class="gv-folder">
      <section class="sp-section first">
        <div class="sp-section-head">
          <span class="sp-section-tag"><%= copy.media.gallery.subalbums_tag %></span>
          <h2><%= copy.media.gallery.subalbums_title %></h2>
        </div>
        <div class="sp-album-grid">
          <% subAlbums.forEach(function(a){ %>
            <%~ include('_album', { a: a }) %>
          <% }) %>
        </div>
      </section>

      <% if (node.images.length) { %>
        <section class="sp-section">
          <div class="sp-section-head">
            <span class="sp-section-tag"><%= copy.media.gallery.photos_tag %></span>
            <h2><%= copy.media.gallery.photos_title %></h2>
            <span class="sp-section-aside"><%= copy.media.gallery.photos_aside %></span>
          </div>
          <div class="sp-vsco">
            <% node.images.forEach(function(im){ %>
              <a class="cell" href="<%= im.pageUrl %>" title="<%= escapeHtml(im.hover || im.alt || '') %>">
                <div class="sp-img has-photo" style="background-image: url('<%= im.srcThumb %>');" role="img" aria-label="<%= escapeHtml(im.alt || '') %>"></div>
                <div class="caption">
                  <% if (im.title) { %><div class="title"><%= im.title %></div><% } %>
                  <% if (im.location) { %><div class="where"><%= im.location %></div><% } %>
                  <% if (im.date) { %><div><%= fmtFull(im.date) %></div><% } %>
                </div>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>
    </div>

    <!-- grid view: every image in this subtree, no sub-album cards -->
    <div class="gv-grid">
      <div class="sp-vsco">
        <% allDescendantImages.forEach(function(im){ %>
          <a class="cell" href="<%= im.pageUrl %>" title="<%= escapeHtml(im.hover || im.alt || '') %>">
            <div class="sp-img has-photo" style="background-image: url('<%= im.srcThumb %>');" role="img" aria-label="<%= escapeHtml(im.alt || '') %>"></div>
            <div class="caption">
              <% if (im.title) { %><div class="title"><%= im.title %></div><% } %>
              <% if (im.album && im.album !== node.url) { %><div class="where"><%= im.albumTitle %></div><% } %>
              <% if (im.date) { %><div><%= fmtFull(im.date) %></div><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- feed view: every image in a vertical stream, captions below each -->
    <div class="gv-feed">
      <% allDescendantImages.forEach(function(im){ %>
        <figure class="gv-feed-item">
          <a href="<%= im.pageUrl %>">
            <%~ pictureFor(im, 'med', im.alt, 'loading="lazy" decoding="async"') %>
          </a>
          <figcaption>
            <% if (im.title) { %><span class="t"><%= im.title %></span><% } %>
            <% if (im.alt) { %><span class="alt"><%= im.alt %></span><% } %>
            <span class="m">
              <% if (im.album && im.album !== node.url) { %><a href="<%= im.album %>"><%= im.albumTitle %></a> · <% } %>
              <% if (im.fromPost) { %><a href="<%= im.fromPost.url %>"><%= im.fromPost.title %></a> · <% } %>
              <% if (im.date) { %><%= fmtFull(im.date) %><% } %>
            </span>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  </div>

  <script>
    // Persist gallery view selection in localStorage so it survives page nav.
    (function () {
      var wrap = document.currentScript.previousElementSibling;
      while (wrap && !wrap.classList.contains('gallery-view')) wrap = wrap.previousElementSibling;
      if (!wrap) return;
      var stored = (function(){ try { return localStorage.getItem('gv'); } catch(_){ return null; } })();
      if (stored) {
        var sel = wrap.querySelector('input[value="' + stored + '"]');
        if (sel) sel.checked = true;
      }
      wrap.querySelectorAll('input[type=radio]').forEach(function (r) {
        r.addEventListener('change', function () {
          try { localStorage.setItem('gv', r.value); } catch (_) {}
        });
      });
    })();
  </script>

<% } else if (node.images.length) { %>
  <section class="sp-section first">
    <div class="sp-vsco">
      <% node.images.forEach(function(im){ %>
        <a class="cell" href="<%= im.pageUrl %>" title="<%= escapeHtml(im.hover || im.alt || '') %>">
          <div class="sp-img has-photo" style="background-image: url('<%= im.srcThumb %>');" role="img" aria-label="<%= escapeHtml(im.alt || '') %>"></div>
          <div class="caption">
            <% if (im.title) { %><div class="title"><%= im.title %></div><% } %>
            <% if (im.location) { %><div class="where"><%= im.location %></div><% } %>
            <% if (im.fromPost) { %><div class="where"><%= im.fromPost.title %></div><% } %>
            <% if (im.date) { %><div><%= fmtFull(im.date) %></div><% } %>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
<% } else { %>
  <div class="sp-empty"><%= copy.empty.gallery %></div>
<% } %>
