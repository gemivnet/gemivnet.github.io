<div class="crumbs" style="font-style: italic; font-size: var(--fs-small); color: var(--ink-3); margin-bottom: var(--sp-3);">
  <a href="/media" style="color: var(--ink-3);">Media</a>
  <% breadcrumbs.slice(1).forEach(function(b, i){ %>
    &nbsp;›&nbsp; <a href="<%= b.url %>" style="color: <%= i === breadcrumbs.length - 2 ? 'var(--ink-2)' : 'var(--ink-3)' %>;"><%= b.label.charAt(0).toUpperCase() + b.label.slice(1).replace(/-/g, ' ') %></a>
  <% }) %>
</div>

<header style="margin-bottom: var(--sp-6);">
  <h1><%= node.title %>.</h1>
  <% if (node.subtitle) { %><p style="font-style: italic; color: var(--ink-2); font-size: var(--fs-lg); margin-top: var(--sp-3);"><%= node.subtitle %></p><% } %>
  <% if (node.fromPost) { %>
    <p style="font-style: italic; font-size: var(--fs-small); color: var(--ink-3); margin-top: var(--sp-3);">
      ↩ from the musing: <a href="<%= node.fromPost.url %>"><%= node.fromPost.title %></a>
    </p>
  <% } %>
  <p style="font-style: italic; font-size: var(--fs-small); color: var(--ink-3); margin-top: var(--sp-3);">
    <% if (node.location) { %><%= node.location %><% } %>
    <% if (node.location && node.date) { %> &middot; <% } %>
    <% if (node.date) { %><%= fmtLongDate(node.date) %><% } %>
    <% if ((node.location || node.date)) { %> &middot; <% } %>
    <%= node.images.length %> photos<% if (subAlbums.length) { %> &middot; <%= subAlbums.length %> sub-albums<% } %>
  </p>
</header>

<% if (subAlbums.length) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag">sub-albums</span>
  </div>
  <div class="sp-album-grid">
    <% subAlbums.forEach(function(a){ %>
      <a class="sp-album" href="<%= a.url %>">
        <% if (a.cover) { %>
          <div class="sp-img has-photo" style="aspect-ratio: 4/3; background-image: url('<%= a.cover.med %>'); background-size: cover; background-position: center;"></div>
        <% } else { %>
          <div class="sp-img tinted" style="aspect-ratio: 4/3;"><span class="sp-img-label">[ <%= a.title %> ]</span></div>
        <% } %>
        <div class="meta-row"><span><%= a.date %></span><span><%= a.count %> photos</span></div>
        <h4><%= a.title %></h4>
        <% if (a.subtitle) { %><div class="sub"><%= a.subtitle %></div><% } %>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (node.images.length) { %>
<section class="sp-section <%= subAlbums.length ? '' : 'first' %>">
  <% if (subAlbums.length) { %>
  <div class="sp-section-head">
    <span class="sp-section-tag">loose photos</span>
  </div>
  <% } %>
  <div class="sp-vsco">
    <% node.images.forEach(function(im){ %>
      <a class="cell" href="<%= im.pageUrl %>" title="<%= escapeHtml(im.alt || '') %>">
        <div class="sp-img has-photo" style="background-image: url('<%= im.srcThumb %>'); background-size: cover; background-position: center;" aria-label="<%= escapeHtml(im.alt || '') %>"></div>
        <div class="caption">
          <% if (im.title) { %><div class="title"><%= im.title %></div><% } %>
          <% if (im.location) { %><div class="where"><%= im.location %></div><% } %>
          <% if (im.date) { %><div><%= fmtLongDate(im.date) %></div><% } %>
        </div>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (!subAlbums.length && !node.images.length) { %>
  <div class="sp-empty"><span class="glyph">∅</span><%= copy.empty.gallery %></div>
<% } %>
