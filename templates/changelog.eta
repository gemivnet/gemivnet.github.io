<header class="sp-page-head site-reading">
  <div class="sp-crumb">
    <%= copy.changelog.breadcrumb %> <%= site.version %>
  </div>
  <h1><%= copy.changelog.title %></h1>
  <p class="sp-index-summary"><%= copy.changelog.intro %></p>
</header>

<section>
  <% if (!entries || entries.length === 0) { %>
    <div class="sp-empty"><span class="glyph">∅</span><%= copy.changelog.empty %></div>
  <% } else { %>
    <ol class="changelog">
      <% entries.forEach(function(e){ %>
        <li class="cl-row">
          <div class="cl-line">
            <span class="cl-ver"><%= e.version %></span>
            <span class="cl-date"><%= e.date %></span>
            <a class="cl-hash" href="https://github.com/gemivnet/gemivnet.github.io/commit/<%= e.hash %>" title="view commit on github"><%= e.hash %></a>
          </div>
          <div class="cl-subject"><%= e.subject %></div>
          <% if (e.body) { %><details class="cl-detail"><summary><%= copy.changelog.details_label %></summary><pre><%= e.body %></pre></details><% } %>
        </li>
      <% }) %>
    </ol>
  <% } %>
</section>
