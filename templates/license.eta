<div class="site-reading">
  <header class="sp-page-head">
    <div class="sp-eyebrow">
      <%= copy.license.breadcrumb %>
    </div>
    <h1><%= copy.license.title %></h1>
  </header>

  <article class="sp-prose">
    <p><strong><%= copy.license.short %></strong></p>

    <% ;(copy.license.body || []).forEach(function(para){ %>
      <p><%~ para %></p>
    <% }) %>

    <h2>The short version</h2>
    <ul>
      <% ;(copy.license.bullets || []).forEach(function(b){ %>
        <li><%~ b %></li>
      <% }) %>
    </ul>

    <h2>For commercial use</h2>
    <p><%~ copy.license.commercial %></p>
  </article>
</div>
