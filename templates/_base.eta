<!doctype html>
<html lang="<%= site.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %></title>
  <% if (page.description) { %><meta name="description" content="<%= escapeHtml(page.description) %>"><% } %>
  <% if (page.keywords && page.keywords.length) { %><meta name="keywords" content="<%= escapeHtml(page.keywords.join(', ')) %>"><% } %>
  <link rel="canonical" href="<%= absUrl(page.url) %>">

  <meta property="og:type" content="<%= page.type || 'website' %>">
  <meta property="og:title" content="<%= escapeHtml(page.title) %>">
  <% if (page.description) { %><meta property="og:description" content="<%= escapeHtml(page.description) %>"><% } %>
  <meta property="og:url" content="<%= absUrl(page.url) %>">
  <% if (page.ogImage) { %><meta property="og:image" content="<%= absUrl(page.ogImage) %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&display=swap">
  <link rel="alternate" type="application/rss+xml" title="<%= site.title %>" href="/rss.xml">

  <link rel="stylesheet" href="/tokens.css">
  <link rel="stylesheet" href="/site.css">
  <style>
    html, body { margin: 0; padding: 0; }
    body { min-height: 100vh; background: var(--bg, #f4efe4); }
  </style>
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
  <% } %>
</head>
<body class="<%= page.bodyClass %>">

  <header class="sp-top">
    <div class="sp-top-inner">
      <a href="/" class="sp-logo"><%
        var logo = copy.nav.logo || '';
        if (logo.startsWith('~')) { %><span class="tilde"><%= logo[0] %></span><%= logo.slice(1) %><% }
        else { %><%= logo %><% }
      %></a>
      <nav class="sp-nav" aria-label="Primary">
        <% tabs.forEach(function(t){ %>
          <a href="<%= t.href %>" class="<%= active === t.id ? 'active' : '' %>"><%= t.label %></a>
        <% }) %>
      </nav>
      <div class="sp-status">
        <button class="sp-theme-toggle" id="theme-toggle" type="button" title="toggle theme">&#9728; light</button>
      </div>
    </div>
  </header>

  <main class="site-shell" style="padding-top: var(--sp-7); padding-bottom: var(--sp-7);">
    <%~ body %>
  </main>

  <footer class="sp-footer">
    <div class="sp-footer-inner">
      <div>
        <div class="footer-wordmark"><span class="tilde">~</span>/george.main</div>
        <% if (copy.footer.creed) { %><p class="creed"><%= copy.footer.creed %></p><% } %>
      </div>
      <div>
        <h5><%= copy.footer.elsewhere_heading %></h5>
        <ul>
          <% ;(copy.footer.elsewhere || []).forEach(function(s){ %>
            <li><a href="<%= s.href %>"><%= s.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h5><%= copy.footer.site_links_heading %></h5>
        <ul>
          <% ;(copy.footer.site_links || []).forEach(function(s){ %>
            <li><a href="<%= s.href %>"><%= s.label %></a><% if (s.indicator) { %> &nbsp;<span style="color: var(--accent);">&#9679;</span><% } %></li>
          <% }) %>
          <li><span style="color: var(--ink-3);"><%= site.version %></span></li>
        </ul>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var page = document.body;
      var toggle = document.getElementById('theme-toggle');
      function setTheme(t) {
        if (t === 'dark') { page.classList.remove('light'); toggle.innerHTML = '&#9789; dark'; }
        else { page.classList.add('light'); toggle.innerHTML = '&#9728; light'; }
        try { localStorage.setItem('gm-theme', t); } catch (_) {}
      }
      try { var s = localStorage.getItem('gm-theme'); if (s) setTheme(s); } catch (_) {}
      toggle && toggle.addEventListener('click', function () {
        setTheme(page.classList.contains('light') ? 'dark' : 'light');
      });
    })();
  </script>
</body>
</html>
