<!doctype html>
<html lang="<%= site.language %>"<% if (themeDefault === 'dark') { %> class="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Theme before first paint, so a dark-mode visitor never sees light flash.
    try { var gmT = localStorage.getItem('gm-theme'); if (gmT) document.documentElement.classList.toggle('dark', gmT === 'dark'); } catch (_) {}
  </script>
  <title><%= page.title %></title>
  <% if (page.description) { %><meta name="description" content="<%= escapeHtml(page.description) %>"><% } %>
  <% if (page.keywords && page.keywords.length) { %><meta name="keywords" content="<%= escapeHtml(page.keywords.join(', ')) %>"><% } %>
  <link rel="canonical" href="<%= absUrl(page.url) %>">
  <% if (analytics.tag_id) { %>
  <script>
    // Google Analytics 4, live host only. Page views, for the owner's curiosity.
    // Skipped when the visitor turned it off in the footer (stored in this
    // browser only) or the browser sends Global Privacy Control.
    window.gmAnalyticsOff = function () {
      try { if (localStorage.getItem('gm-analytics') === 'off') return true; } catch (_) {}
      return navigator.globalPrivacyControl === true;
    };
    if (location.hostname === <%~ JSON.stringify(new URL(site.url).hostname) %> && !window.gmAnalyticsOff()) {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=<%= analytics.tag_id %>';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
    }
  </script>
  <% } %>
  <% if (page.jsonLd) { %><script type="application/ld+json"><%~ page.jsonLd %></script><% } %>

  <meta property="og:type" content="<%= page.type || 'website' %>">
  <meta property="og:title" content="<%= escapeHtml(page.title) %>">
  <% if (page.description) { %><meta property="og:description" content="<%= escapeHtml(page.description) %>"><% } %>
  <meta property="og:url" content="<%= absUrl(page.url) %>">
  <% if (page.ogImage) { %><meta property="og:image" content="<%= absUrl(page.ogImage) %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://georgemain-com-media.s3.amazonaws.com" crossorigin>
  <link rel="preload" href="/fonts/ibm-plex-serif-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/plex.css<%= typeof assetV !== 'undefined' && assetV ? '?v=' + assetV : '' %>">
  <link rel="alternate" type="application/rss+xml" title="<%= site.title %> (RSS)" href="/rss.xml">
  <link rel="alternate" type="application/atom+xml" title="<%= site.title %> (Atom)" href="/atom.xml">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/tokens.css<%= typeof assetV !== 'undefined' && assetV ? '?v=' + assetV : '' %>">
  <link rel="stylesheet" href="/site.css<%= typeof assetV !== 'undefined' && assetV ? '?v=' + assetV : '' %>">
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%~ JSON.stringify(jsonLd) %></script>
  <% } %>
</head>
<body class="<%= page.bodyClass %>">

  <a class="skip-link" href="#main"><%= copy.ui.skip_to_content %></a>

  <header class="sp-top">
    <div class="sp-top-inner">
      <a href="/" class="sp-logo"><%
        var logo = copy.nav.logo || '';
        if (logo.startsWith('~')) { %><span class="tilde"><%= logo[0] %></span><%= logo.slice(1) %><% }
        else { %><%= logo %><% }
      %></a>
      <nav class="sp-nav" aria-label="Primary">
        <% tabs.forEach(function(t){ %>
          <a href="<%= t.href %>"<% if (active === t.id) { %> aria-current="page"<% } %>><%= t.label %></a>
        <% }) %>
      </nav>
      <div class="sp-status">
        <a href="/search" class="sp-search-link"<% if (active === 'search') { %> aria-current="page"<% } %>><%= copy.search.nav_label %></a>
        <button class="sp-theme-toggle" id="theme-toggle" type="button" aria-label="<%= copy.ui.theme_aria %>"><%= copy.ui.theme_light %></button>
      </div>
    </div>
  </header>

  <main class="site-shell" id="main">
    <%~ body %>
  </main>

  <footer class="sp-footer">
    <div class="sp-footer-inner">
      <div>
        <div class="sp-footer-mark"><span class="tilde">~</span>/george.main</div>
        <% if (copy.footer.creed) { %><p class="creed"><%= copy.footer.creed %></p><% } %>
      </div>
      <div>
        <h3><%= copy.footer.elsewhere_heading %></h3>
        <ul>
          <% ;(copy.footer.elsewhere || []).forEach(function(s){ %>
            <li><a href="<%= s.href %>"><%= s.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h3><%= copy.footer.site_links_heading %></h3>
        <ul>
          <% ;(copy.footer.site_links || []).forEach(function(s){ %>
            <li><a href="<%= s.href %>"><%= s.label %></a><% if (s.indicator) { %><span class="dot" aria-hidden="true">&#9679;</span><% } %></li>
          <% }) %>
          <% if (analytics.tag_id) { %>
          <li class="sp-optout" id="sp-optout" hidden>
            <a href="/license#analytics"><%= copy.footer.analytics.label %></a>
            <span id="sp-optout-state"></span>
            <button type="button" class="sp-link-btn" id="sp-optout-btn"></button>
          </li>
          <script>
          (function () {
            // The analytics opt-out. A choice made here is kept in this browser
            // and applies from the next page on; turning it off also stops this
            // page's tag from sending anything further.
            var C = <%~ JSON.stringify(copy.footer.analytics) %>;
            var box = document.getElementById('sp-optout');
            var state = document.getElementById('sp-optout-state');
            var btn = document.getElementById('sp-optout-btn');
            var gpc = navigator.globalPrivacyControl === true;
            function paint() {
              var off = window.gmAnalyticsOff && window.gmAnalyticsOff();
              state.textContent = gpc ? C.gpc : off ? C.off : C.on;
              btn.textContent = off ? C.turn_on : C.turn_off;
              btn.hidden = gpc;
              window['ga-disable-<%= analytics.ga4_id %>'] = !!off;
            }
            btn.addEventListener('click', function () {
              var off = window.gmAnalyticsOff && window.gmAnalyticsOff();
              try { if (off) localStorage.removeItem('gm-analytics'); else localStorage.setItem('gm-analytics', 'off'); } catch (_) {}
              paint();
            });
            box.hidden = false;
            paint();
          })();
          </script>
          <% } %>
          <% if (typeof allPostUrls !== 'undefined' && allPostUrls && allPostUrls.length) { %>
            <li><a href="#" id="random-musing-link" data-urls='<%~ JSON.stringify(allPostUrls) %>'><%= copy.ui.random_link %></a></li>
          <% } %>
          <% if (typeof hasLinks !== 'undefined' && hasLinks) { %><li><a href="/links"><%= copy.links.footer_label %></a></li><% } %>
          <li><a href="/license"><%= copy.copyright.link_text %></a></li>
          <li class="fine"><%= copy.copyright.line %></li>
          <li class="version"><%= site.version %></li>
        </ul>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var root = document.documentElement;
      var toggle = document.getElementById('theme-toggle');
      var LABEL = <%~ JSON.stringify({ light: copy.ui.theme_light, dark: copy.ui.theme_dark }) %>;
      function paint() { if (toggle) toggle.innerHTML = root.classList.contains('dark') ? LABEL.dark : LABEL.light; }
      paint();
      toggle && toggle.addEventListener('click', function () {
        var dark = !root.classList.contains('dark');
        root.classList.toggle('dark', dark);
        try { localStorage.setItem('gm-theme', dark ? 'dark' : 'light'); } catch (_) {}
        paint();
      });

      // "/" from anywhere: jump to search (or into the box, if it's on the page).
      document.addEventListener('keydown', function (e) {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        var t = e.target;
        if (t && (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable)) return;
        e.preventDefault();
        var box = document.getElementById('sx-q');
        if (box) box.focus(); else window.location.href = '/search';
      });

      var rnd = document.getElementById('random-musing-link');
      if (rnd) {
        rnd.addEventListener('click', function (e) {
          e.preventDefault();
          try {
            var urls = JSON.parse(rnd.getAttribute('data-urls') || '[]');
            if (urls.length) window.location.href = urls[Math.floor(Math.random() * urls.length)];
          } catch (_) {}
        });
      }
    })();
  </script>
</body>
</html>
