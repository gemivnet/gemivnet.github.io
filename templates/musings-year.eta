<header style="margin-bottom: var(--sp-6);">
  <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--ink-3); margin-bottom: var(--sp-3);">
    ~/musings/<%= year %> · <%= posts.length %> posts
  </div>
  <h1><%= year %>.</h1>
</header>

<section>
  <% posts.forEach(function(p){ %>
    <article class="sp-card">
      <div class="sp-meta">
        <span><%= fmtDate(p.date).replace(/-/g, '·') %></span>
        <% if (p.category[0]) { %><span class="sep">·</span><span class="cat"><%= p.category[0] %></span><% } %>
        <span class="sep">·</span>
        <span><%= p.wordCount.toLocaleString() %> w · ~<%= p.readTime %> min</span>
      </div>
      <h3><a href="<%= p.url %>"><%= p.title %></a></h3>
      <% if (p.subtitle) { %><p class="sp-sub"><%= p.subtitle %></p><% } %>
      <p class="sp-preview"><%= p.preview %></p>
      <div class="sp-tags">
        <% p.tags.forEach(function(t){ %><a class="sp-tag" href="/musings/tag/<%= t.toLowerCase().replace(/[^a-z0-9]+/g,'-') %>"><%= t %></a><% }) %>
      </div>
    </article>
  <% }) %>
</section>

<% if (otherYears.length) { %>
<section style="margin-top: var(--sp-6); padding-top: var(--sp-4); border-top: 1px solid var(--rule); font-family: var(--font-mono); font-size: var(--fs-small); color: var(--ink-3);">
  other years: <% otherYears.forEach(function(y, i){ %><a href="/musings/<%= y %>"><%= y %></a><%= i < otherYears.length - 1 ? ' · ' : '' %><% }) %>
</section>
<% } %>
