<div class="musings-layout">
  <%~ include('_rail', { copy: copy, rail: rail, escapeHtml: escapeHtml }) %>

  <div class="musings-main">
    <header class="sp-page-head">
      <div class="sp-crumb">~/<%= section.root %>/<%= year %> · <%= posts.length %> posts</div>
      <h1><%= year %>.</h1>
    </header>

    <%~ include('_entries', { copy: copy, entries: entries, listCopy: sectionCopy.index, section: section, escapeHtml: escapeHtml }) %>

    <% if (otherYears.length) { %>
    <p class="sp-backlink">
      <%= sectionCopy.year.other_years %> <% otherYears.forEach(function(y, i){ %><a href="<%= section.base %>/<%= y %>"><%= y %></a><%= i < otherYears.length - 1 ? ' · ' : '' %><% }) %>
    </p>
    <% } %>
  </div>
</div>
