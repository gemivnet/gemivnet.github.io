<div class="musings-layout">
  <aside class="musings-tree" aria-label="FOIA archive">
    <input type="checkbox" id="tree-toggle" class="tree-toggle">
    <label class="tree-head" for="tree-toggle">browse</label>
    <%~ treeHtml %>
  </aside>

  <div class="musings-main">
    <header class="sp-post-header">
      <div class="crumbs">
        <a href="/">~</a> &nbsp;/&nbsp; <a href="/foia"><%= copy.foia.request.crumbs_root %></a>
        &nbsp;/&nbsp; <span style="color: var(--ink-2);"><%= archive.kind %></span>
      </div>
      <h1><%= archive.heading %></h1>
      <p class="subtitle"><%= archive.blurb %></p>
    </header>

    <% if (requests.length === 0) { %>
      <div class="sp-empty"><span class="glyph">∅</span><%= copy.empty.foia_archive %></div>
    <% } %>

    <% ;(requests).forEach(function(r){ %>
      <article class="sp-card foia-card">
        <div class="sp-meta">
          <span style="color: var(--accent); font-weight: 600;"><%= r.filed %></span>
          <% if (archive.kind !== 'agency') { %>
            <span class="sep">·</span>
            <a class="foia-chip" href="/foia/agency/<%= r.agencySlug %>"><%= r.agencyShort %></a>
          <% } %>
          <span class="sep">·</span>
          <span class="foia-status is-<%= r.status %>"><%= r.statusLabel %></span>
        </div>
        <h3><a href="<%= r.url %>"><%= r.title %></a></h3>
        <% if (r.blurb) { %><p class="sp-preview"><%= r.blurb %></p><% } %>
        <div class="foia-card-foot">
          <span><%= r.releaseCount %> release<%= r.releaseCount === 1 ? '' : 's' %></span>
          <span class="sep">·</span>
          <span><%= r.docCount %> document<%= r.docCount === 1 ? '' : 's' %></span>
          <% if (r.pageCount) { %><span class="sep">·</span><span><%= r.pageCount.toLocaleString() %> pp</span><% } %>
          <% if (r.byteCountFmt) { %><span class="sep">·</span><span><%= r.byteCountFmt %></span><% } %>
        </div>
      </article>
    <% }) %>

    <div style="text-align: center; margin-top: var(--sp-5); font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);">
      <a href="/foia"><%= copy.foia.request.back_label %></a>
    </div>
  </div>
</div>
