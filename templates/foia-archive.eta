<div class="musings-layout">
  <%~ include('_rail', { copy: copy, rail: rail, escapeHtml: escapeHtml }) %>

  <div class="musings-main">
    <header class="sp-page-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">~</a><span class="sep">/</span><a href="/foia"><%= copy.foia.request.crumbs_root %></a><span class="sep">/</span><span class="here"><%= archive.kind %></span>
      </nav>
      <h1><%= archive.heading %></h1>
    </header>

    <%~ include('_entries', { copy: copy, entries: entries, listCopy: copy.foia.index, section: { base: '/foia' }, escapeHtml: escapeHtml }) %>

    <div class="sp-backlink">
      <a href="/foia"><%= copy.foia.request.back_label %></a>
    </div>
  </div>
</div>
