<div class="musings-layout">
  <aside class="musings-tree" aria-label="FOIA archive">
    <input type="checkbox" id="tree-toggle" class="tree-toggle">
    <label class="tree-head" for="tree-toggle">browse</label>
    <%~ treeHtml %>
  </aside>

  <div class="musings-main">
    <header class="sp-post-header">
      <div class="crumbs">
        <a href="/">~</a> &nbsp;/&nbsp; <a href="/foia"><%= copy.foia.request.crumbs_root %></a>
        &nbsp;/&nbsp; <span style="color: var(--ink-2);"><%= archive.kind %></span>
      </div>
      <h1><%= archive.heading %></h1>
    </header>

    <% if (requests.length === 0) { %>
      <div class="sp-empty"><span class="glyph">∅</span><%= copy.empty.foia_archive %></div>
    <% } else { %>
    <div class="foia-table-wrap">
      <table class="foia-table">
        <thead>
          <tr>
            <th scope="col"><%= copy.foia.table.th_filed %></th>
            <th scope="col"><%= copy.foia.table.th_request %></th>
            <th scope="col" class="r"><%= copy.foia.table.th_outcome %></th>
          </tr>
        </thead>
        <tbody>
          <% ;(requests).forEach(function(r){ %>
            <tr>
              <td class="when"><%= r.filed %></td>
              <th scope="row">
                <a href="<%= r.url %>"><%= r.title %></a>
                <span class="sub">
                  <% if (archive.kind !== 'agency') { %><a href="/foia/agency/<%= r.agencySlug %>"><%= r.agencyShort %></a><% } else { %><%= r.statute %><% } %>
                  <% if (r.docCount) { %> · <%= r.docCount %> doc<%= r.docCount === 1 ? '' : 's' %><% } %>
                  <% if (r.pageCount) { %> · <%= r.pageCount.toLocaleString() %> pp<% } %>
                  <% if (r.tracking) { %> · <%= r.tracking %><% } %>
                </span>
              </th>
              <td class="out">
                <span class="<%= r.status === 'open' ? 'is-open' : '' %>"><%= r.statusLabel %></span>
                <% if (r.fees.paid) { %><span class="fee paid"><%= r.fees.paidFmt %> paid</span>
                <% } else if (r.fees.pending && r.fees.quoted) { %><span class="fee"><%= r.fees.quotedFmt %> pending</span>
                <% } else if (r.fees.quoted) { %><span class="fee strike"><%= r.fees.quotedFmt %></span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div style="text-align: center; margin-top: var(--sp-6); font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);">
      <a href="/foia"><%= copy.foia.request.back_label %></a>
    </div>
  </div>
</div>
