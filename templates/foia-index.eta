<header style="margin-bottom: var(--sp-6);">
  <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--ink-3); margin-bottom: var(--sp-3);">
    <%= copy.foia.index.breadcrumb %> · <%= totals.requests %> request<%= totals.requests === 1 ? '' : 's' %> · <%= totals.documents %> documents<% if (totals.pages) { %> · <%= totals.pages.toLocaleString() %> pages<% } %>
  </div>
  <h1><%= copy.foia.heading %></h1>
  <p style="color: var(--ink-2); max-width: var(--reading-width); margin-top: var(--sp-3);"><%= copy.foia.index.intro %></p>
</header>

<% if (ledger.length === 0) { %>
  <div class="sp-empty"><span class="glyph">∅</span><%= copy.empty.foia_index %></div>
<% } else { %>
<div class="foia-table-wrap">
  <table class="foia-table">
    <thead>
      <tr>
        <th scope="col"><%= copy.foia.table.th_filed %></th>
        <th scope="col"><%= copy.foia.table.th_request %></th>
        <th scope="col" class="r"><%= copy.foia.table.th_outcome %></th>
      </tr>
    </thead>
    <tbody>
      <% ;(ledger).forEach(function(r){ %>
        <tr>
          <td class="when"><%= r.filed %></td>
          <th scope="row">
            <a href="<%= r.url %>"><%= r.title %></a>
            <span class="sub">
              <a href="/foia/agency/<%= r.agencySlug %>"><%= r.agencyShort %></a>
              <% if (r.docCount) { %> · <%= r.docCount %> doc<%= r.docCount === 1 ? '' : 's' %><% } %>
              <% if (r.pageCount) { %> · <%= r.pageCount.toLocaleString() %> pp<% } %>
              <% if (r.tracking) { %> · <%= r.tracking %><% } %>
            </span>
          </th>
          <td class="out">
            <span class="<%= r.status === 'open' ? 'is-open' : '' %>"><%= r.statusLabel %></span>
            <% if (r.fees.paid) { %><span class="fee paid"><%= r.fees.paidFmt %> paid</span>
            <% } else if (r.fees.pending && r.fees.quoted) { %><span class="fee"><%= r.fees.quotedFmt %> pending</span>
            <% } else if (r.fees.waiver === 'granted') { %><span class="fee"><%= copy.foia.table.fee_waived %></span>
            <% } else if (r.fees.quoted) { %><span class="fee strike"><%= r.fees.quotedFmt %></span><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<div class="foia-note-foot">
  <p><span style="color: var(--accent);">ⓘ</span> <%= copy.foia.ai_notice.short %></p>
  <p><%= copy.foia.rights.site_note %></p>
  <details>
    <summary><%= copy.foia.rights.tag %> &amp; <%= copy.foia.ai_notice.tag %></summary>
    <% ;(copy.foia.ai_notice.body).forEach(function(p){ %><p><%= p %></p><% }) %>
    <p><%= copy.foia.rights.caveat %>
      <a href="<%= copy.foia.rights.contact_href %>"><%= copy.foia.rights.contact_label %></a>
    </p>
  </details>
</div>
