<%
  /* Shared entry list. Used by /musings, /rv12is and /foia so all three
     scroll, sort and read the same way. Callers pass a normalized `entries`
     array built by entryFromPost/entryFromRequest in build.mjs; nothing in
     here knows what a musing or a records request is.

     Locals are underscored because `useWith` puts the caller's data in scope:
     `var entries = entries || []` would shadow it with undefined. */
  var _entries = (typeof entries !== 'undefined' && entries) || [];
  var _pinned  = (typeof pinnedEntries !== 'undefined' && pinnedEntries) || [];
  var _c       = (typeof listCopy !== 'undefined' && listCopy) || {};
%>

<% if (_pinned.length) { %>
<section class="sp-pinned" aria-label="Pinned entries">
  <div class="sp-strip-label">// <%= _c.pinned_label || 'pinned' %></div>
  <div class="sp-pinned-row">
    <% _pinned.forEach(function(e){ %>
      <a class="sp-pin" href="<%= e.url %>">
        <span class="sp-pin-thumb<%= e.thumb ? '' : ' is-empty' %>"><% if (e.thumb) { %><img src="<%= e.thumb %>" alt="" width="160" height="160" loading="lazy" decoding="async"><% } %></span>
        <span class="sp-pin-text">
          <span class="sp-pin-title"><%= e.title %></span>
          <% if (e.subtitle) { %><span class="sp-pin-sub"><%= e.subtitle %></span><% } %>
        </span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (_entries.length === 0) { %>
  <div class="sp-empty"><span class="glyph">∅</span><%= _c.empty || 'nothing here yet.' %></div>
<% } else { %>

<div class="sp-sort" hidden>
  <span class="sp-sort-label"><%= _c.sort_label || 'sort:' %></span>
  <button type="button" data-sort="desc" class="is-on"><%= _c.sort_newest || 'newest first' %></button>
  <span class="sp-sort-sep">/</span>
  <button type="button" data-sort="asc"><%= _c.sort_oldest || 'oldest first' %></button>
</div>

<div id="sp-stream">
<% var _lastYear = null; _entries.forEach(function(e){ %>
  <% if (e.year !== _lastYear) { _lastYear = e.year; %>
    <div class="sp-year" data-year="<%= e.year %>">// <%= e.year %></div>
  <% } %>
  <article class="sp-card sp-entry" data-ts="<%= e.ts %>" data-year="<%= e.year %>">
    <a class="sp-entry-thumb<%= e.thumb ? '' : ' is-empty' %>" href="<%= e.url %>" tabindex="-1" aria-hidden="true"><% if (e.thumb) { %><img src="<%= e.thumb %>" alt="" width="160" height="160" loading="lazy" decoding="async"><% } %></a>
    <div class="sp-entry-body">
      <div class="sp-meta">
        <% ;(e.meta || []).forEach(function(m, i){ %><% if (i) { %><span class="sep">·</span><% } %><span class="<%= m.cls || '' %>"><%= m.text %></span><% }) %>
      </div>
      <h3><a href="<%= e.url %>"><%= e.title %></a></h3>
      <% if (e.subtitle) { %><p class="sp-sub"><%= e.subtitle %></p><% } %>
      <% if (e.preview) { %><p class="sp-preview"><%= e.preview %></p><% } %>
      <% if (e.tags && e.tags.length) { %><div class="sp-tags"><% e.tags.forEach(function(t){ %><a class="sp-tag" href="<%= t.href %>"><%= t.label %></a><% }) %></div><% } %>
    </div>
    <a class="sp-entry-open" href="<%= e.url %>" data-peek data-peek-title="<%= escapeHtml(e.title) %>" aria-label="Read <%= escapeHtml(e.title) %>">&rsaquo;</a>
  </article>
<% }) %>
</div>
<% } %>

<%
  /* Reading pane. Ships inert and empty; the script moves it to <body> and
     fills it on demand. With JS off the > above is an ordinary link. */
%>
<aside class="sp-peek" id="sp-peek" hidden>
  <div class="sp-peek-scrim" data-peek-close></div>
  <div class="sp-peek-panel" role="dialog" aria-modal="true" aria-labelledby="sp-peek-title" tabindex="-1">
    <div class="sp-peek-bar">
      <span class="sp-peek-crumb" id="sp-peek-title"></span>
      <a class="sp-peek-full" id="sp-peek-full" href="<%= section.base %>">full page &rarr;</a>
      <button class="sp-peek-close" type="button" data-peek-close aria-label="Close reading pane">&times;</button>
    </div>
    <div class="sp-peek-body" id="sp-peek-body"></div>
  </div>
</aside>

<script>
(function () {
  // Sort control. The markup ships newest-first, so with JS off the default is
  // already correct and the control stays hidden.
  var stream = document.getElementById('sp-stream');
  var bar = document.querySelector('.sp-sort');
  if (!stream || !bar || !stream.querySelector('[data-ts]')) return;
  bar.hidden = false;

  var entries = [].slice.call(stream.querySelectorAll('.sp-entry'));

  function apply(dir) {
    var sorted = entries.slice().sort(function (a, b) {
      var d = +a.getAttribute('data-ts') - +b.getAttribute('data-ts');
      return dir === 'asc' ? d : -d;
    });
    // Rebuild from scratch so the // year rules land in the right places.
    [].slice.call(stream.querySelectorAll('.sp-year')).forEach(function (n) { n.remove(); });
    var lastYear = null;
    sorted.forEach(function (el) {
      var y = el.getAttribute('data-year');
      if (y !== lastYear) {
        lastYear = y;
        var h = document.createElement('div');
        h.className = 'sp-year';
        h.setAttribute('data-year', y);
        h.textContent = '// ' + y;
        stream.appendChild(h);
      }
      stream.appendChild(el);
    });
    [].slice.call(bar.querySelectorAll('button')).forEach(function (b) {
      b.classList.toggle('is-on', b.getAttribute('data-sort') === dir);
    });
    try { localStorage.setItem('gm-rv-sort', dir); } catch (_) {}
  }

  bar.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('button[data-sort]');
    if (b) apply(b.getAttribute('data-sort'));
  });

  try { var s = localStorage.getItem('gm-rv-sort'); if (s === 'asc') apply('asc'); } catch (_) {}
})();
</script>

<script>
(function () {
  var mount = document.getElementById('sp-peek');
  // No fetch/DOMParser: leave the › as an ordinary link and do nothing.
  if (!mount || !window.fetch || !window.DOMParser || !document.body.closest) return;
  document.body.appendChild(mount); // out of .site-shell's stacking context

  var main   = document.getElementById('main');
  var panel  = mount.querySelector('.sp-peek-panel');
  var bodyEl = document.getElementById('sp-peek-body');
  var titleEl= document.getElementById('sp-peek-title');
  var fullEl = document.getElementById('sp-peek-full');
  var cache  = {};
  var openUrl = null;
  var lastFocus = null;

  function inert(on) { try { if (main) main.inert = on; } catch (_) {} }

  function close(fromPop) {
    if (!openUrl) return;
    var hadState = history.state && history.state.spPeek;
    openUrl = null;
    mount.classList.remove('is-open');
    inert(false);
    document.documentElement.classList.remove('sp-peek-lock');
    setTimeout(function () { if (!openUrl) { mount.hidden = true; bodyEl.innerHTML = ''; } }, 220);
    if (!fromPop && hadState) history.back();
    if (lastFocus) { try { lastFocus.focus(); } catch (_) {} }
  }

  function fill(url) {
    if (cache[url]) { bodyEl.innerHTML = cache[url]; return; }
    bodyEl.innerHTML = '<p class="sp-peek-status">loading&hellip;</p>';
    fetch(url, { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw 0; return r.text(); })
      .then(function (t) {
        var doc = new DOMParser().parseFromString(t, 'text/html');
        // .musings-main wraps the body on every section's post page, so one
        // selector covers musings, rv12is entries and foia requests alike.
        var main = doc.querySelector('.musings-main');
        if (!main) throw 0;
        ['.crumbs', '.sp-postnav', '.sp-backlink'].forEach(function (sel) {
          var n = main.querySelector(sel);
          if (n) n.remove();
        });
        cache[url] = main.innerHTML;
        if (openUrl === url) bodyEl.innerHTML = cache[url];
      })
      .catch(function () { if (openUrl === url) window.location.href = url; });
  }

  function open(url, title) {
    if (openUrl === url) return;
    if (!openUrl) lastFocus = document.activeElement;
    var replacing = !!openUrl;
    openUrl = url;
    titleEl.textContent = title || '';
    fullEl.href = url;
    mount.hidden = false;
    document.documentElement.classList.add('sp-peek-lock');
    // Two frames: let [hidden] drop before the transform transition starts.
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { mount.classList.add('is-open'); });
    });
    inert(true);
    panel.scrollTop = 0;
    panel.focus();
    var st = { spPeek: url };
    if (replacing && history.state && history.state.spPeek) history.replaceState(st, '', url);
    else history.pushState(st, '', url);
    fill(url);
  }

  document.addEventListener('click', function (e) {
    if (!e.target || !e.target.closest) return;
    if (e.target.closest('[data-peek-close]')) { e.preventDefault(); close(false); return; }
    var link = e.target.closest('[data-peek]');
    if (!link) return;
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // let new-tab through
    e.preventDefault();
    open(link.getAttribute('href'), link.getAttribute('data-peek-title'));
  });

  document.addEventListener('keydown', function (e) {
    if (openUrl && (e.key === 'Escape' || e.key === 'Esc')) { e.preventDefault(); close(false); }
  });

  window.addEventListener('popstate', function () { close(true); });
})();
</script>
