<div class="nf">
  <div class="sp-crumb"><%= copy.not_found.breadcrumb %></div>
  <h1><%= copy.not_found.heading %></h1>
  <p><%= copy.not_found.paragraph %></p>
  <div class="actions">
    <% copy.not_found.buttons.forEach(function(b, i){ %>
      <a class="sp-btn <%= i === 0 ? 'primary' : '' %>" href="<%= b.href %>"><%= b.label %></a>
    <% }) %>
  </div>
</div>
