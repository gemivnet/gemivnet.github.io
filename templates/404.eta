<div style="max-width: 580px; margin: var(--sp-9) auto; padding-block: var(--sp-7);">
  <div class="sp-eyebrow">
    <%= copy.not_found.breadcrumb %>
  </div>
  <h1 style="font-size: var(--fs-mega); letter-spacing: -0.025em; line-height: 1.0; margin-bottom: var(--sp-4);"><%= copy.not_found.heading %></h1>
  <p style="font-size: 19px; color: var(--ink-2); margin-bottom: var(--sp-6);"><%= copy.not_found.paragraph %></p>
  <div style="display: flex; gap: var(--sp-3); flex-wrap: wrap;">
    <% copy.not_found.buttons.forEach(function(b, i){ %>
      <a class="sp-btn <%= i === 0 ? 'primary' : '' %>" href="<%= b.href %>"><%= b.label %></a>
    <% }) %>
  </div>
</div>
