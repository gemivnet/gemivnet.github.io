<div class="crumbs" style="font-style: italic; font-size: var(--fs-small); color: var(--ink-3); margin-bottom: var(--sp-3);">
  <a href="/media" style="color: var(--ink-3);">Media</a>
  <% breadcrumbs.slice(1).forEach(function(b){ %>
    &nbsp;›&nbsp; <a href="<%= b.url %>" style="color: var(--ink-3);"><%= b.label.charAt(0).toUpperCase() + b.label.slice(1).replace(/-/g, ' ') %></a>
  <% }) %>
</div>

<div class="sp-photo-frame">
  <a class="photo-arrow prev" href="<%= prev.pageUrl %>" aria-label="Previous photo">‹</a>
  <img src="<%= image.src %>" alt="<%= escapeHtml(image.alt || '') %>" title="<%= escapeHtml(image.alt || '') %>">
  <a class="photo-arrow next" href="<%= next.pageUrl %>" aria-label="Next photo">›</a>
</div>

<% if (image.alt) { %>
<p style="font-style: italic; color: var(--ink-2); margin-top: var(--sp-3); margin-bottom: var(--sp-2); font-size: var(--fs-lg);">
  <%= image.alt %>
</p>
<% } %>

<div class="sp-photo-counter">
  <a href="<%= prev.pageUrl %>" style="color: var(--ink-2); text-decoration: none;">←&nbsp;previous</a>
  &nbsp; &nbsp;
  <b><%= index + 1 %></b> of <%= total %>
  &nbsp; &nbsp;
  <a href="<%= next.pageUrl %>" style="color: var(--ink-2); text-decoration: none;">next&nbsp;→</a>
  <div style="margin-top: 4px; color: var(--ink-3); font-style: italic; font-size: var(--fs-small);">
    (← / → on the keyboard. it wraps around at the ends.)
  </div>
</div>

<dl class="sp-photo-meta">
  <% if (image.title) { %><dt>title</dt><dd><%= image.title %></dd><% } %>
  <% if (image.date)  { %><dt>date</dt><dd><%= fmtLongDate(image.date) %></dd><% } %>
  <% if (image.location || node.location) { %><dt>where</dt><dd><%= image.location || node.location %></dd><% } %>
  <dt>album</dt><dd><a href="<%= node.url %>"><%= node.title %></a></dd>
  <% if (image.exif) { %>
    <% if (image.exif.camera) { %><dt>camera</dt><dd><%= image.exif.camera %></dd><% } %>
    <% if (image.exif.lens)   { %><dt>lens</dt><dd><%= image.exif.lens %></dd><% } %>
    <% var settings = [image.exif.focal_length, image.exif.aperture, image.exif.shutter, image.exif.iso && 'ISO ' + image.exif.iso].filter(Boolean).join(' · '); %>
    <% if (settings) { %><dt>settings</dt><dd><%= settings %></dd><% } %>
    <% if (image.exif.width && image.exif.height) { %>
      <% var mp = ((image.exif.width * image.exif.height) / 1000000).toFixed(1); %>
      <dt>dimensions</dt><dd><%= image.exif.width %> × <%= image.exif.height %> · <%= mp %> MP</dd>
    <% } %>
  <% } %>
  <% if (image.bytes) { %><dt>size</dt><dd><%= fmtBytes(image.bytes) %></dd><% } %>
  <% if (image.s3) { %>
    <dt>original</dt><dd><a href="<%= image.s3 %>">view full size ↗</a></dd>
  <% } %>
</dl>

<div style="margin-top: var(--sp-6); font-style: italic; font-size: var(--fs-small);">
  <a href="<%= node.url %>">↑ back to <%= node.title %></a>
</div>

<script>
  (function(){
    document.addEventListener('keydown', function(e){
      if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
      if (e.key === 'ArrowLeft')  window.location.href = '<%= prev.pageUrl %>';
      if (e.key === 'ArrowRight') window.location.href = '<%= next.pageUrl %>';
    });
  })();
</script>
