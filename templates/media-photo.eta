<div class="photo-page">
  <div class="crumbs" style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--ink-3); letter-spacing: 0.02em; margin-bottom: var(--sp-3);">
    <a href="/" style="color: var(--ink-3); text-decoration: none;">~</a>
    <% breadcrumbs.forEach(function(b){ %>
      &nbsp;/&nbsp; <a href="<%= b.url %>" style="color: var(--ink-3); text-decoration: none;"><%= b.label %></a>
    <% }) %>
    &nbsp;/&nbsp; <span style="color: var(--ink-2);"><%= image.slug %></span>
  </div>

  <figure class="photo-figure">
    <img src="<%= image.src %>" alt="<%= escapeHtml(image.alt || '') %>" title="<%= escapeHtml(image.alt || '') %>">
    <% if (image.alt) { %><figcaption><%= image.alt %></figcaption><% } %>
  </figure>

  <div class="photo-meta">
    <table>
      <tbody>
        <% if (image.title) { %><tr><td>title</td><td><%= image.title %></td></tr><% } %>
        <% if (image.date)  { %><tr><td>date</td><td><%= fmtDate(image.date) %></td></tr><% } %>
        <% if (image.location || node.location) { %><tr><td>where</td><td><%= image.location || node.location %></td></tr><% } %>
        <tr><td>album</td><td><a href="<%= node.url %>"><%= node.title %></a></td></tr>
        <% if (image.exif) { %>
          <% if (image.exif.camera)       { %><tr><td>camera</td><td><%= image.exif.camera %></td></tr><% } %>
          <% if (image.exif.lens)         { %><tr><td>lens</td><td><%= image.exif.lens %></td></tr><% } %>
          <% var settings = [image.exif.focal_length, image.exif.aperture, image.exif.shutter, image.exif.iso && 'ISO ' + image.exif.iso].filter(Boolean).join(' · '); %>
          <% if (settings) { %><tr><td>settings</td><td><%= settings %></td></tr><% } %>
          <% if (image.exif.width && image.exif.height) { %><tr><td>dimensions</td><td><%= image.exif.width %> × <%= image.exif.height %></td></tr><% } %>
        <% } %>
        <% if (image.s3) { %>
          <tr><td>original</td><td><a href="<%= image.s3 %>">view full size ↗</a></td></tr>
        <% } else { %>
          <tr><td>file</td><td><a href="<%= image.src %>"><%= image.file %></a></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <nav class="photo-nav" aria-label="Photo navigation">
    <a class="prev" href="<%= prev.pageUrl %>"><span class="label">← previous</span><span class="title"><%= prev.title || prev.alt || prev.file %></span></a>
    <span class="counter"><%= index + 1 %> / <%= total %></span>
    <a class="next" href="<%= next.pageUrl %>"><span class="label">next →</span><span class="title"><%= next.title || next.alt || next.file %></span></a>
  </nav>

  <div style="text-align: center; margin-top: var(--sp-5); font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);">
    <a href="<%= node.url %>">↑ back to <%= node.title %></a>
  </div>
</div>

<style>
  .photo-page { max-width: 1000px; margin: 0 auto; }
  .photo-figure { margin: 0 0 var(--sp-5); text-align: center; }
  .photo-figure img { max-width: 100%; height: auto; border: 1px solid var(--rule); }
  .photo-figure figcaption {
    font-family: var(--font-mono); font-size: var(--fs-small);
    color: var(--ink-2); margin-top: var(--sp-3);
    padding-left: var(--sp-3); border-left: 2px solid var(--rule);
    text-align: left; max-width: var(--reading-width); margin-left: auto; margin-right: auto;
  }
  .photo-meta { max-width: 520px; margin: var(--sp-5) auto; }
  .photo-meta table {
    font-family: var(--font-mono); font-size: var(--fs-small);
    border-collapse: collapse; width: 100%;
  }
  .photo-meta td { padding: 4px 12px 4px 0; vertical-align: top; }
  .photo-meta td:first-child { color: var(--ink-3); width: 80px; }
  .photo-meta td:last-child { color: var(--ink-2); }
  .photo-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--sp-4);
    align-items: center;
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }
  .photo-nav .label { display: block; font-size: var(--fs-tiny); color: var(--ink-3); letter-spacing: 0.04em; margin-bottom: 2px; }
  .photo-nav a { color: var(--ink); text-decoration: none; }
  .photo-nav a:hover .title { color: var(--accent); }
  .photo-nav .next { text-align: right; }
  .photo-nav .counter { color: var(--ink-3); font-size: var(--fs-tiny); }
</style>

<script>
  // arrow-key navigation
  (function(){
    document.addEventListener('keydown', function(e){
      if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
      if (e.key === 'ArrowLeft')  window.location.href = '<%= prev.pageUrl %>';
      if (e.key === 'ArrowRight') window.location.href = '<%= next.pageUrl %>';
    });
  })();
</script>
