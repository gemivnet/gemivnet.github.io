<section class="sp-page-head">
  <div class="sp-eyebrow">
    <%= sectionCopy.tag.breadcrumb_prefix %><%= tag %> · <%= posts.length %> posts
  </div>
  <h1>#<%= tag %></h1>
  <p style="margin-top: var(--sp-4); color: var(--ink-2); font-size: 18px;"><%= sectionCopy.tag.intro %></p>
</section>

<%~ include('_entries', { copy: copy, entries: entries, listCopy: sectionCopy.index, section: section, escapeHtml: escapeHtml }) %>
