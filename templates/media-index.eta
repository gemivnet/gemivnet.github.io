<header class="sp-page-head">
  <div class="sp-crumb"><%= copy.media.index.breadcrumb %> · <%= albums.length %> albums</div>
  <h1><%= copy.media.index.title %></h1>
  <p class="sp-index-summary"><%= copy.media.index.intro %></p>
</header>

<% if (albums.length === 0) { %>
  <div class="sp-empty"><%= copy.empty.media %></div>
<% } %>

<div class="sp-album-grid">
  <% albums.forEach(function(a){ %>
    <%~ include('_album', { a: a }) %>
  <% }) %>
</div>
