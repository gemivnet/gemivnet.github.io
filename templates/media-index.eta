<header style="margin-bottom: var(--sp-7);">
  <h1>Media.</h1>
  <p style="margin-top: var(--sp-3); color: var(--ink-2); font-size: var(--fs-lg); font-style: italic;">
    <%= copy.media.index.intro %>
  </p>
</header>

<% if (albums.length === 0) { %>
  <div class="sp-empty"><span class="glyph">∅</span><%= copy.empty.media %></div>
<% } %>

<div class="sp-album-grid">
  <% albums.forEach(function(a){ %>
    <a class="sp-album" href="<%= a.url %>">
      <% if (a.cover) { %>
        <div class="sp-img has-photo" style="aspect-ratio: 4/3; background-image: url('<%= a.cover.med %>'); background-size: cover; background-position: center;"></div>
      <% } else { %>
        <div class="sp-img tinted" style="aspect-ratio: 4/3;"><span class="sp-img-label">[ <%= a.title %> ]</span></div>
      <% } %>
      <div class="meta-row">
        <span><%= a.date %></span>
        <span><%= a.count %> photos</span>
      </div>
      <h4><%= a.title %></h4>
      <% if (a.subtitle) { %><div class="sub"><%= a.subtitle %></div><% } %>
      <% if (a.location) { %><div class="meta-row"><span><%= a.location %></span></div><% } %>
    </a>
  <% }) %>
</div>
