<% if (shuffled.length > 0) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.random_musing.section_tag %></span>
    <h2><%= copy.home.random_musing.title %></h2>
    <span class="sp-section-aside" id="musing-counter">1 of <%= shuffled.length %></span>
  </div>
  <div class="sp-block">
    <div class="sp-block-meta">
      <span class="path" id="musing-path"><%= shuffled[0].path %></span>
      <span>·</span>
      <span id="musing-date"><%= shuffled[0].dateMono %></span>
      <span>·</span>
      <span id="musing-readtime"><%= shuffled[0].readtime %></span>
    </div>
    <h3 style="font-size: var(--fs-2xl); margin-bottom: 4px;">
      <a id="musing-title" href="<%= shuffled[0].url %>" style="color: var(--ink); text-decoration: none;"><%= shuffled[0].title %></a>
    </h3>
    <p id="musing-sub" style="font-style: italic; color: var(--ink-2); font-size: var(--fs-lg); margin-bottom: var(--sp-3);"><%= shuffled[0].subtitle %></p>
    <p id="musing-body" style="color: var(--ink-2);"><%= shuffled[0].preview %></p>
    <div class="sp-tags" id="musing-tags" style="margin-top: var(--sp-3);"></div>
    <div class="sp-block-actions">
      <button class="sp-link-btn" id="musing-random" type="button">↻ random</button>
      <button class="sp-link-btn" id="musing-next" type="button">→ next</button>
      <a class="sp-link-btn" id="musing-read" href="<%= shuffled[0].url %>">read post</a>
      <% if (copy.home.random_musing.key_hint) { %><span class="hint"><%= copy.home.random_musing.key_hint %></span><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (shuffledImages.length > 0) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.random_photo.section_tag %></span>
    <h2><%= copy.home.random_photo.title %></h2>
    <span class="sp-section-aside" id="photo-counter">1 of <%= shuffledImages.length %></span>
  </div>
  <div class="sp-block">
    <div class="sp-block-meta">
      <span class="path" id="photo-path"></span>
    </div>
    <a id="photo-link" href="<%= shuffledImages[0].album %>" style="display:block; margin-bottom: var(--sp-3);">
      <img id="photo-img" src="<%= shuffledImages[0].src %>" alt="<%= escapeHtml(shuffledImages[0].alt || '') %>" title="<%= escapeHtml(shuffledImages[0].alt || '') %>" style="width:100%; height:auto; display:block; border:1px solid var(--rule); aspect-ratio: 3/2; object-fit: cover;">
    </a>
    <p id="photo-sub" style="font-style: italic; color: var(--ink-2); margin-bottom: 4px;"><%= shuffledImages[0].title || shuffledImages[0].alt || '' %></p>
    <p id="photo-meta" style="color: var(--ink-3); font-family: var(--font-mono); font-size: var(--fs-tiny); letter-spacing: 0.02em;"></p>
    <div class="sp-block-actions">
      <button class="sp-link-btn" id="photo-random" type="button">↻ random</button>
      <button class="sp-link-btn" id="photo-next" type="button">→ next</button>
      <a class="sp-link-btn" id="photo-open" href="<%= shuffledImages[0].album %>">open album</a>
      <% if (copy.home.random_photo.key_hint) { %><span class="hint"><%= copy.home.random_photo.key_hint %></span><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (recent.length > 0) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.lately.section_tag %></span>
    <h2><%= copy.home.lately.title %></h2>
    <span class="sp-section-aside">last <%= recent.length %> of <%= totalMusings %></span>
  </div>
  <div style="font-family: var(--font-mono); font-size: var(--fs-small);">
    <% recent.forEach(function(r){ %>
      <div style="display: grid; grid-template-columns: 100px 1fr 100px; gap: var(--sp-4); padding: 10px 0; border-top: 1px solid var(--rule); align-items: baseline;">
        <span style="color: var(--ink-3);"><%= r.date %></span>
        <a href="<%= r.url %>" style="color: var(--ink); text-decoration: none;"><%= r.title %></a>
        <span style="color: var(--accent); text-align: right;">·<%= r.category %></span>
      </div>
    <% }) %>
    <div style="border-top: 1px solid var(--rule); padding-top: var(--sp-3); margin-top: var(--sp-2);">
      <a href="/musings" style="color: var(--accent);">browse all <%= totalMusings %> musings →</a>
    </div>
  </div>
</section>
<% } %>

<script id="random-data" type="application/json"><%- JSON.stringify({ musings: shuffled, photos: shuffledImages }) %></script>
<script>
(function () {
  var data = JSON.parse(document.getElementById('random-data').textContent);

  (function () {
    var list = data.musings || []; if (!list.length) return;
    var i = 0;
    function render() {
      var m = list[i];
      function set(id, t) { var el = document.getElementById(id); if (el) el.textContent = t; }
      set('musing-path', m.path);
      set('musing-counter', (i + 1) + ' of ' + list.length);
      set('musing-date', m.dateMono);
      set('musing-readtime', m.readtime);
      var t = document.getElementById('musing-title'); t.textContent = m.title; t.href = m.url;
      set('musing-sub', m.subtitle);
      set('musing-body', m.preview);
      var read = document.getElementById('musing-read'); if (read) read.href = m.url;
      var tagWrap = document.getElementById('musing-tags');
      if (tagWrap) {
        tagWrap.innerHTML = '';
        (m.tags || []).forEach(function (t) {
          var a = document.createElement('a');
          a.className = 'sp-tag';
          a.href = '/musings/tag/' + t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          a.textContent = t;
          tagWrap.appendChild(a);
        });
      }
    }
    render();
    document.getElementById('musing-random').addEventListener('click', function () {
      if (list.length < 2) return;
      var n; do { n = Math.floor(Math.random() * list.length); } while (n === i);
      i = n; render();
    });
    document.getElementById('musing-next').addEventListener('click', function () {
      i = (i + 1) % list.length; render();
    });
    document.addEventListener('keydown', function (e) {
      if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
      if (e.key === 'r' || e.key === 'R') document.getElementById('musing-random').click();
    });
  })();

  (function () {
    var list = data.photos || []; if (!list.length) return;
    var i = 0;
    function render() {
      var p = list[i];
      function set(id, t) { var el = document.getElementById(id); if (el) el.textContent = t; }
      set('photo-path', p.album + '/' + p.full.split('/').pop());
      set('photo-counter', (i + 1) + ' of ' + list.length);
      set('photo-sub', p.title || p.alt || '');
      var parts = [];
      if (p.location) parts.push(p.location.toLowerCase());
      if (p.date) parts.push(p.date);
      set('photo-meta', parts.join(' · '));
      var img = document.getElementById('photo-img');
      img.src = p.src; img.alt = p.alt || ''; img.title = p.alt || '';
      document.getElementById('photo-link').href = p.album;
      var open = document.getElementById('photo-open'); if (open) open.href = p.album;
    }
    render();
    document.getElementById('photo-random').addEventListener('click', function () {
      if (list.length < 2) return;
      var n; do { n = Math.floor(Math.random() * list.length); } while (n === i);
      i = n; render();
    });
    document.getElementById('photo-next').addEventListener('click', function () {
      i = (i + 1) % list.length; render();
    });
  })();
})();
</script>
