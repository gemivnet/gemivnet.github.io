<% if (copy.footer.creed) { %><p class="home-intro"><%= copy.footer.creed %></p><% } %>

<% if (shuffled.length > 0) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.random_musing.section_tag %></span>
    <h2><%= copy.home.random_musing.title %></h2>
    <span class="sp-section-aside" id="musing-counter">1 of <%= shuffled.length %></span>
  </div>
  <div class="sp-block">
    <p class="meta">
      <span class="home-path" id="musing-path"><%= shuffled[0].path %></span><span class="sep">·</span><span id="musing-readtime"><%= shuffled[0].readtime %></span>
    </p>
    <h3 class="home-title"><a id="musing-title" href="<%= shuffled[0].url %>"><%= shuffled[0].title %></a></h3>
    <p class="home-sub" id="musing-sub"><%= shuffled[0].subtitle %></p>
    <p id="musing-body"><%= shuffled[0].preview %></p>
    <div class="sp-tags" id="musing-tags"></div>
    <div class="sp-block-actions">
      <button class="sp-link-btn" id="musing-random" type="button"><%= copy.home.random_musing.random_label %></button>
      <button class="sp-link-btn" id="musing-next" type="button"><%= copy.home.random_musing.next_label %></button>
      <a class="sp-link-btn" id="musing-read" href="<%= shuffled[0].url %>"><%= copy.home.random_musing.read_label %></a>
      <% if (copy.home.random_musing.key_hint) { %><span class="hint"><%= copy.home.random_musing.key_hint %></span><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (shuffledImages.length > 0) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.random_photo.section_tag %></span>
    <h2><%= copy.home.random_photo.title %></h2>
    <span class="sp-section-aside" id="photo-counter">1 of <%= shuffledImages.length %></span>
  </div>
  <div class="sp-block wide">
    <p class="meta" id="photo-path"></p>
    <a class="home-photo" id="photo-link" href="<%= shuffledImages[0].album %>">
      <img id="photo-img" src="<%= shuffledImages[0].src %>" alt="<%= escapeHtml(shuffledImages[0].alt || '') %>" title="<%= escapeHtml(shuffledImages[0].hover || shuffledImages[0].alt || '') %>">
    </a>
    <p class="home-sub" id="photo-sub"><%= shuffledImages[0].title || shuffledImages[0].alt || '' %></p>
    <p class="meta" id="photo-meta"></p>
    <div class="sp-block-actions">
      <button class="sp-link-btn" id="photo-random" type="button"><%= copy.home.random_photo.random_label %></button>
      <button class="sp-link-btn" id="photo-next" type="button"><%= copy.home.random_photo.next_label %></button>
      <a class="sp-link-btn" id="photo-open" href="<%= shuffledImages[0].album %>"><%= copy.home.random_photo.open_label %></a>
      <% if (copy.home.random_photo.key_hint) { %><span class="hint"><%= copy.home.random_photo.key_hint %></span><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (recent.length > 0) { %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.lately.section_tag %></span>
    <h2><%= copy.home.lately.title %></h2>
    <span class="sp-section-aside"><%= copy.home.lately.aside %></span>
  </div>
  <div class="sp-block">
    <%~ include('_entries', { copy: copy, entries: recent, listCopy: {}, section: section, escapeHtml: escapeHtml, sortable: false }) %>
    <p class="sp-backlink"><a href="/musings"><%= copy.home.lately.more.replace('{n}', totalMusings) %></a></p>
  </div>
</section>
<% } %>

<% if (stats && stats.musings > 0) { var sl = copy.home.stats.labels; %>
<section class="sp-section">
  <div class="sp-section-head">
    <span class="sp-section-tag"><%= copy.home.stats.section_tag %></span>
    <h2><%= copy.home.stats.title %></h2>
    <span class="sp-section-aside"><%= copy.home.stats.aside %></span>
  </div>
  <p class="stats-line">
    <%= sl.musings %> <b><%= stats.musings.toLocaleString() %></b><span class="sep">·</span><%= sl.words %> <b><%= stats.words.toLocaleString() %></b><span class="sep">·</span><%= sl.musings_size %> <b><%= stats.musingsBytesFmt %></b><span class="sep">·</span><%= sl.pictures %> <b><%= stats.pictures.toLocaleString() %></b><span class="sep">·</span><%= sl.pictures_size %> <b><%= stats.picturesBytesFmt %></b><span class="sep">·</span><%= sl.first_post %> <b><%= stats.firstPost || '-' %></b><span class="sep">·</span><%= sl.last_post %> <b><%= stats.lastPost || '-' %></b>
  </p>
  <% if (recipeStats) { var rl = copy.home.stats.recipes; %>
  <p class="stats-line">
    <a href="/recipes"><%= copy.home.stats.recipes_label %></a>:
    <%= rl.recipes %> <b><%= recipeStats.recipes.toLocaleString() %></b><span class="sep">·</span><%= rl.categories %> <b><%= recipeStats.categories %></b><span class="sep">·</span><%= rl.steps %> <b><%= recipeStats.steps.toLocaleString() %></b><span class="sep">·</span><%= rl.ingredients %> <b><%= recipeStats.ingredients.toLocaleString() %></b><span class="sep">·</span><%= rl.with_nutrition %> <b><%= recipeStats.withNutrition %></b><span class="sep">·</span><%= rl.pages %> <b><%= recipeStats.pages %></b>
  </p>
  <% } %>
</section>
<% } %>

<script id="random-data" type="application/json"><%~ JSON.stringify({ musings: shuffled, photos: shuffledImages }) %></script>
<script>
(function () {
  var data = JSON.parse(document.getElementById('random-data').textContent);

  // Prefetch a small rolling window of shuffle photos instead of all of them.
  // warming every image cost ~46MB on page load.
  function warmPhotos(list, from) {
    for (var d = 1; d <= 3; d++) {
      var p = list[(from + d) % list.length];
      if (p && p.src) { var im = new Image(); im.src = p.src; }
    }
  }

  (function () {
    var list = data.musings || []; if (!list.length) return;
    var i = 0;
    function render() {
      var m = list[i];
      function set(id, t) { var el = document.getElementById(id); if (el) el.textContent = t; }
      set('musing-path', m.path);
      set('musing-counter', (i + 1) + ' of ' + list.length);
      set('musing-readtime', m.readtime);
      var t = document.getElementById('musing-title'); t.textContent = m.title; t.href = m.url;
      set('musing-sub', m.subtitle);
      set('musing-body', m.preview);
      var read = document.getElementById('musing-read'); if (read) read.href = m.url;
      var tagWrap = document.getElementById('musing-tags');
      if (tagWrap) {
        tagWrap.innerHTML = '';
        (m.tags || []).forEach(function (t) {
          var a = document.createElement('a');
          a.className = 'sp-tag';
          a.href = '/musings/tag/' + t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          a.textContent = t;
          tagWrap.appendChild(a);
        });
      }
    }
    render();
    document.getElementById('musing-random').addEventListener('click', function () {
      if (list.length < 2) return;
      var n; do { n = Math.floor(Math.random() * list.length); } while (n === i);
      i = n; render();
    });
    document.getElementById('musing-next').addEventListener('click', function () {
      i = (i + 1) % list.length; render();
    });
    document.addEventListener('keydown', function (e) {
      if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
      if (e.key === 'r' || e.key === 'R') document.getElementById('musing-random').click();
    });
  })();

  (function () {
    var list = data.photos || []; if (!list.length) return;
    var i = 0;
    function render() {
      var p = list[i];
      function set(id, t) { var el = document.getElementById(id); if (el) el.textContent = t; }
      set('photo-path', p.album + '/' + p.full.split('/').pop());
      set('photo-counter', (i + 1) + ' of ' + list.length);
      set('photo-sub', p.title || p.alt || '');
      var parts = [];
      if (p.location) parts.push(p.location.toLowerCase());
      if (p.date) parts.push(p.date);
      set('photo-meta', parts.join(' · '));
      var img = document.getElementById('photo-img');
      img.src = p.src; img.alt = p.alt || ''; img.title = p.hover || p.alt || '';
      document.getElementById('photo-link').href = p.album;
      var open = document.getElementById('photo-open'); if (open) open.href = p.album;
      warmPhotos(list, i);
    }
    render();
    document.getElementById('photo-random').addEventListener('click', function () {
      if (list.length < 2) return;
      var n; do { n = Math.floor(Math.random() * list.length); } while (n === i);
      i = n; render();
    });
    document.getElementById('photo-next').addEventListener('click', function () {
      i = (i + 1) % list.length; render();
    });
  })();
})();
</script>
