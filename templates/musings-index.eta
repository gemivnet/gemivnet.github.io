<div class="musings-layout">
  <aside class="musings-tree" aria-label="Musings folder tree">
    <input type="checkbox" id="tree-toggle" class="tree-toggle">
    <label class="tree-head" for="tree-toggle">browse</label>
    <div class="tree-content">
      <div class="tree-label">~/musings</div>
      <%~ treeHtml %>
    </div>
  </aside>

  <div class="musings-body">
    <header style="margin-bottom: var(--sp-7);">
      <h1>Musings.</h1>
      <p style="margin-top: var(--sp-3); color: var(--ink-2); font-size: var(--fs-lg); font-style: italic;">
        <%= copy.musings.index.intro %>
      </p>
    </header>

    <% if (posts.length === 0) { %>
      <div class="sp-empty"><span class="glyph">∅</span><%= copy.empty.musings_index %></div>
    <% } %>

    <% posts.forEach(function(p){ %>
      <article class="sp-card">
        <div class="sp-meta">
          <span><%= fmtLongDate(p.date) %></span>
          <% if (p.category.length) { %><span class="sep">·</span><span class="cat"><%= p.category.join('/') %></span><% } %>
          <span class="sep">·</span>
          <span><%= p.wordCount.toLocaleString() %> words · ~<%= p.readTime %> min read</span>
        </div>
        <h3><a href="<%= p.url %>"><%= p.title %></a></h3>
        <% if (p.subtitle) { %><p class="sp-sub"><%= p.subtitle %></p><% } %>
        <p class="sp-preview"><%= p.preview %></p>
        <div class="sp-tags">
          <% p.tags.forEach(function(t){ %><a class="sp-tag" href="/musings/tag/<%= t.toLowerCase().replace(/[^a-z0-9]+/g,'-') %>"><%= t %></a><% }) %>
        </div>
      </article>
    <% }) %>
  </div>
</div>
