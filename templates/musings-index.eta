<header style="margin-bottom: var(--sp-6);">
  <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--ink-3); margin-bottom: var(--sp-3);">
    <%= sectionCopy.index.breadcrumb %> · <%= posts.length %> posts
  </div>
  <h1><%= sectionCopy.heading %></h1>
  <% if (sectionCopy.index.summary) { %><p class="sp-index-summary"><%= sectionCopy.index.summary %></p><% } %>
</header>

<%
  var folderCounts = {};
  posts.forEach(function(p){ if (p.category.length) { var k = p.category[0]; folderCounts[k] = (folderCounts[k] || 0) + 1; } });
  var folders = Object.keys(folderCounts).sort();
  var tagCounts = {};
  posts.forEach(function(p){ p.tags.forEach(function(t){ tagCounts[t] = (tagCounts[t] || 0) + 1; }); });
  var topTags = Object.entries(tagCounts).sort(function(a,b){ return b[1]-a[1]; }).slice(0, 12).map(function(x){ return x[0]; });
%>

<% if (folders.length || topTags.length) { %>
<div class="sp-browse">
  <% if (folders.length) { %>
    <div class="sp-browse-label">browse by folder:</div>
    <div class="sp-browse-row">
      <a href="<%= section.base %>" class="is-all">all (<%= posts.length %>)</a>
      <% folders.forEach(function(k){ %>
        <a href="<%= section.base %>/<%= k %>"><%= k %>/ <span class="n"><%= folderCounts[k] %></span></a>
      <% }) %>
    </div>
  <% } %>
  <% if (topTags.length) { %>
    <div class="sp-browse-label" style="margin-top: var(--sp-3);">browse by tag:</div>
    <div>
      <% topTags.forEach(function(t){ %><a class="sp-tag" href="<%= section.base %>/tag/<%= t.toLowerCase().replace(/[^a-z0-9]+/g,'-') %>"><%= t %></a><% }) %>
    </div>
  <% } %>
</div>
<% } %>

<%~ include('_entries', { entries: entries, pinnedEntries: pinnedEntries, listCopy: sectionCopy.index, section: section, escapeHtml: escapeHtml }) %>
