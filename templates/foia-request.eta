<div class="musings-layout">
  <aside class="musings-tree" aria-label="FOIA archive">
    <input type="checkbox" id="tree-toggle" class="tree-toggle">
    <label class="tree-head" for="tree-toggle">browse</label>
    <%~ treeHtml %>
  </aside>

  <div class="musings-main">
    <header class="sp-post-header">
      <div class="crumbs">
        <a href="/">~</a> &nbsp;/&nbsp; <a href="/foia"><%= copy.foia.request.crumbs_root %></a>
        &nbsp;/&nbsp; <span style="color: var(--ink-2);"><%= req.slug %></span>
      </div>
      <h1><%= req.title %></h1>
    </header>

    <% /* facts as one run of prose, not a grid of boxes */ %>
    <div class="foia-meta">
      <b><%= req.agency %></b><span class="sep">·</span><%= req.statute %>
      <% if (req.tracking) { %><span class="sep">·</span><%= req.tracking %><% } %>
      <br>
      filed <b><%= fmtLongDate(req.filed) %></b><% if (req.closed) { %><span class="sep">·</span>closed <b><%= fmtLongDate(req.closed) %></b><% } %>
      <span class="sep">·</span><b class="<%= req.status === 'open' ? '' : '' %>"><%= req.statusLabel %></b>
      <% if (req.docCount) { %>
        <span class="sep">·</span><b><%= req.docCount %></b> document<%= req.docCount === 1 ? '' : 's' %><% if (req.pageCount) { %>, <b><%= req.pageCount.toLocaleString() %></b> pages<% } %>
      <% } %>
      <% if (req.fees.quoted || req.fees.paid || req.fees.waiverLabel) { %>
        <br>
        <% if (req.fees.paid) { %><b><%= req.fees.paidFmt %></b> paid<% } %>
        <% if (req.fees.quoted) { %><% if (req.fees.paid) { %><span class="sep">·</span><% } %><b><%= req.fees.quotedFmt %></b> quoted<% } %>
        <% if (req.fees.waiverLabel) { %><span class="sep">·</span><%= req.fees.waiverLabel %><% } %>
      <% } %>
      <% if (req.tags.length) { %>
        <br>
        <% ;(req.tags).forEach(function(t){ %><a href="/foia/tag/<%= t.toLowerCase().replace(/[^a-z0-9]+/g,'-') %>">#<%= t %></a> <% }) %>
      <% } %>
      <% if (req.fees.note) { %><span class="fee-note"><%= req.fees.note %></span><% } %>
    </div>

    <% if (req.summary) { %>
      <div class="foia-summary" data-ai-generated="true">
        <% ;(req.summary.text.split(/\n{2,}/)).forEach(function(para){ %>
          <p><%= para.replace(/\n/g, ' ') %></p>
        <% }) %>
        <p class="disclosure">
          <span style="color: var(--accent);">ⓘ</span>
          <%= (req.summary.reviewed ? copy.foia.summary.disclosure_reviewed : copy.foia.summary.disclosure)
                .replace('{model}', req.summary.generatedBy)
                .replace('{date}', req.summary.generatedOn) %>
        </p>
      </div>
    <% } %>

    <% if (req.timeline.length === 0) { %>
      <div class="sp-empty"><%= copy.foia.request.no_timeline %></div>
    <% } else { %>

    <% /* Multi-pronged: a JS-free lane filter. One generated rule per track,
          because CSS can't match a checked input's value against an attribute.
          Untracked events are never hidden. They belong to every prong. */ %>
    <% if (req.tracks.length > 1) { %>
      <style>
        <% ;(req.tracks).forEach(function(t){ %>
          #tf-<%= req.slug %>-<%= t.id %>:checked ~ .foia-timeline [data-track]:not([data-track="<%= t.id %>"]) { display: none; }
          #tf-<%= req.slug %>-<%= t.id %>:checked ~ .foia-track-pick label[for="tf-<%= req.slug %>-<%= t.id %>"] { color: var(--accent); border-bottom-color: var(--accent); }
        <% }) %>
        #tf-<%= req.slug %>-all:checked ~ .foia-track-pick label[for="tf-<%= req.slug %>-all"] { color: var(--accent); border-bottom-color: var(--accent); }
      </style>
      <div class="foia-tracks">
        <input type="radio" name="tf-<%= req.slug %>" id="tf-<%= req.slug %>-all" checked>
        <% ;(req.tracks).forEach(function(t){ %>
          <input type="radio" name="tf-<%= req.slug %>" id="tf-<%= req.slug %>-<%= t.id %>">
        <% }) %>
        <div class="foia-track-pick">
          <label for="tf-<%= req.slug %>-all"><%= copy.foia.request.track_filter_all %></label>
          <% ;(req.tracks).forEach(function(t){ %>
            <label for="tf-<%= req.slug %>-<%= t.id %>"><%= t.label %></label>
          <% }) %>
        </div>
    <% } %>

    <ol class="foia-timeline">
      <% var lastYear = null; ;(groups).forEach(function(g){
           var d = g.kind === 'fold' ? g.events[0].date : g.ev.date;
           var y = d.getUTCFullYear(); %>
        <% if (y !== lastYear) { lastYear = y; %>
          <li class="foia-year">// <%= y %></li>
        <% } %>

        <% if (g.kind === 'fold') { %>
          <li>
            <details class="foia-fold"<% if (g.track) { %> data-track="<%= g.track %>"<% } %>>
              <summary><%= g.span %> · <%= g.label %><% if (g.trackLabel) { %> · <%= g.trackLabel %><% } %></summary>
              <ol style="list-style: none; padding: 0; margin: 0;">
                <% ;(g.events).forEach(function(ev){ %>
                  <li class="foia-event is-minor">
                    <div class="when"><%= fmtMetaDate(ev.date).slice(0, 6) %></div>
                    <div class="what">
                      <h3><%= ev.title %></h3>
                      <div class="kind"><span class="t"><%= ev.typeLabel %></span><% if (ev.tracking) { %> · <%= ev.tracking %><% } %></div>
                      <% if (ev.note) { %><p class="note"><%= ev.note %></p><% } %>
                    </div>
                  </li>
                <% }) %>
              </ol>
            </details>
          </li>
        <% } else { var ev = g.ev; %>
          <li class="foia-event is-<%= ev.type %>"<% if (ev.track) { %> data-track="<%= ev.track %>"<% } %>>
            <div class="when"><%= fmtMetaDate(ev.date).slice(0, 6) %></div>
            <div class="what">
              <h3><%= ev.title %></h3>
              <div class="kind">
                <span class="t"><%= ev.typeLabel %></span>
                <% if (ev.trackLabel) { %> · <%= ev.trackLabel %><% } %>
                <% if (ev.tracking) { %> · <%= ev.tracking %><% } %>
                <% if (ev.exemptions.length) { %> · <%= copy.foia.labels.exemptions %> <%= ev.exemptions.join(', ') %><% } %>
              </div>
              <% if (ev.note) { %><p class="note"><%= ev.note %></p><% } %>
              <% if (ev.isRelease) { %>
                <ul class="docs">
                  <% ;(ev.files).forEach(function(d){ %>
                    <li><a href="<%= d.url %>"><%= d.title %></a> <span class="m"><% if (d.pages) { %><%= d.pages %> pp · <% } %><%= d.bytesFmt %></span></li>
                  <% }) %>
                </ul>
                <a class="more" href="<%= ev.url %>"><%= copy.foia.request.open_label %></a>
              <% } %>
            </div>
          </li>
        <% } %>
      <% }) %>
    </ol>

    <% if (req.tracks.length > 1) { %></div><% } %>
    <% } %>

    <div class="foia-note-foot">
      <p><span style="color: var(--accent);">ⓘ</span> <%= copy.foia.ai_notice.short %></p>
      <p><%= req.rights.note %></p>
      <p><%= copy.foia.rights.caveat %>
        <a href="<%= copy.foia.rights.contact_href %>"><%= copy.foia.rights.contact_label %></a>
      </p>
    </div>

    <div class="sp-backlink" style="text-align: center; margin-top: var(--sp-6); font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);">
      <a href="/foia"><%= copy.foia.request.back_label %></a>
    </div>
  </div>
</div>
