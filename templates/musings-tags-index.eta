<header style="margin-bottom: var(--sp-6);">
  <div style="font-family: var(--font-mono); font-size: var(--fs-tiny); color: var(--ink-3); margin-bottom: var(--sp-3);">
    ~/musings/tags · <%= tagList.length %> tags
  </div>
  <h1>Tags.</h1>
</header>

<section>
  <% if (tagList.length === 0) { %>
    <div class="sp-empty"><span class="glyph">∅</span>no tags yet.</div>
  <% } %>
  <ul class="cat-list">
    <% tagList.forEach(function(t){ %>
      <li><a href="/musings/tag/<%= t.slug %>">#<%= t.name %></a><span class="count">(<%= t.count %>)</span></li>
    <% }) %>
  </ul>
</section>
