<%
  /* One recipe card as a web page. The data is the card's own (imported from
     the Typst source), so this mirrors the PDF: spec line, then each step with
     the ingredients it uses beside the procedure, then swaps, notes and the
     nutrition table. The print page prints the PDF itself. */
  var r = recipe, rc = copy.recipes;
  var mass = function (g) { return g == null ? '' : (typeof g === 'number' ? g + ' g' : g); };
  var specs = [
    [rc.spec.yield, r.yield], [rc.spec.active, r.active], [rc.spec.total, r.total], [rc.spec.oven, r.oven],
    [r.servings === 1 ? rc.spec.per_batch : rc.spec.per_serving, r.perServing],
  ].filter(function (s) { return s[1]; });
  var stepNo = 0;
%>
<div class="musings-layout">
  <aside class="musings-tree" aria-label="Recipes">
    <input type="checkbox" id="tree-toggle" class="tree-toggle">
    <label class="tree-head" for="tree-toggle"><%= copy.ui.sidebar_browse %></label>
    <%~ treeHtml %>
  </aside>

  <div class="musings-main">
    <header class="sp-post-header">
      <div class="crumbs">
        <a href="/">~</a> &nbsp;/&nbsp; <a href="/recipes"><%= rc.post.crumbs_root %></a>
        &nbsp;/&nbsp; <a href="/recipes/<%= r.categorySlug %>"><%= escapeHtml(r.category) %></a>
        &nbsp;/&nbsp; <span class="rc-crumb-here"><%= r.slug %></span>
      </div>
      <h1><%= escapeHtml(r.title) %></h1>
    </header>

    <div class="foia-meta rc-meta">
      <% specs.forEach(function(s, i){ %><% if (i) { %><span class="sep">·</span><% } %><span class="rc-spec"><%= s[0] %> <b><%~ s[1] %></b></span><% }) %>
      <% if (r.equipment.length) { %><span class="rc-line"><%= rc.spec.equipment %> <b><%~ r.equipment.join(' · ') %></b></span><% } %>
      <% if (r.source) { %><span class="rc-line"><%= rc.spec.source %> <b><%~ r.source %></b></span><% } %>
      <span class="rc-line rc-actions">
        <a href="<%= r.url %>/print"><%= rc.post.print_label %></a>
        <span class="sep">·</span>
        <a href="<%= r.pdfUrl %>"><%= rc.post.pdf_label %></a> <span class="rc-dim">(<%= pagesLabel %>)</span>
        <% if (r.revised) { %><span class="sep">·</span><span class="rc-dim"><%= rc.spec.revised %> <%= r.revised %></span><% } %>
      </span>
    </div>

    <ol class="rc-steps">
      <% r.items.forEach(function(it){ %>
        <% if (it.kind === 'stage') { %>
          <li class="rc-stage"><%~ it.name %></li>
        <% } else { stepNo++; %>
          <li class="rc-step<%= it.ings.length ? '' : ' no-ings' %>">
            <span class="rc-num"><%= stepNo %></span>
            <% if (it.ings.length) { %>
            <table class="rc-ings">
              <% it.ings.forEach(function(i){ %>
                <tr>
                  <td class="rc-ing-name"><%~ i.name %><% if (i.note) { %><span class="rc-note">, <%~ i.note %></span><% } %></td>
                  <td class="rc-ing-g"><%~ mass(i.g) %></td>
                  <td class="rc-ing-vol"><%~ i.vol || '' %></td>
                </tr>
              <% }) %>
            </table>
            <% } %>
            <div class="rc-proc"><%~ it.body %></div>
          </li>
        <% } %>
      <% }) %>
    </ol>

    <% if (r.swaps) { %>
    <div class="rc-block">
      <div class="sp-strip-label">// <%= rc.swaps_tag %></div>
      <table class="rc-table">
        <tr><th><%~ r.swaps.header[0] %></th><th><%~ r.swaps.header[1] %></th></tr>
        <% r.swaps.rows.forEach(function(row){ %>
          <tr><td><%~ row.original %></td><td><% row.alts.forEach(function(a, n){ %><% if (n) { %><span class="sep"> · </span><% } %><span class="rc-alt"><b><%= n + 1 %></b> <%~ a %></span><% }) %></td></tr>
        <% }) %>
      </table>
    </div>
    <% } %>

    <% if (r.notes.length) { %>
    <div class="rc-block">
      <div class="sp-strip-label">// <%= rc.notes_tag %></div>
      <ul class="rc-notes"><% r.notes.forEach(function(n){ %><li><%~ n %></li><% }) %></ul>
    </div>
    <% } %>

    <% if (r.nutrition) { var nu = r.nutrition; %>
    <div class="rc-block">
      <div class="sp-strip-label">// <%= rc.nutrition.tag %></div>
      <table class="rc-table rc-nutrition">
        <tr><th></th><th class="num"><%= rc.nutrition.mass %></th><% nu.used.forEach(function(k){ %><th class="num"><%= rc.nutrition.columns[k] %></th><% }) %></tr>
        <% nu.rows.forEach(function(x){ %>
          <tr><td><%~ x.name %><% if (x.note) { %><span class="rc-note">, <%~ x.note %></span><% } %></td><td class="num"><%~ mass(x.g) %></td><% x.values.forEach(function(v){ %><td class="num"><%= v %></td><% }) %></tr>
        <% }) %>
        <tr class="rc-total rc-total-first"><td><%= rc.nutrition.total %></td><td></td><% nu.totals.forEach(function(v){ %><td class="num"><%= v %></td><% }) %></tr>
        <% if (nu.per) { %><tr class="rc-total"><td><%= rc.nutrition.per_serving.replace('{n}', r.servings) %></td><td></td><% nu.per.forEach(function(v){ %><td class="num"><%= v %></td><% }) %></tr><% } %>
      </table>
      <% if (r.nutritionSource) { %><p class="rc-caption"><%= rc.nutrition.source_prefix %> <%~ r.nutritionSource %></p><% } %>
    </div>
    <% } %>

    <%~ include('_recipe-disclaimer', { copy: copy }) %>

    <div class="sp-backlink">
      <a href="/recipes"><%= rc.post.back_label %></a>
    </div>
  </div>
</div>
