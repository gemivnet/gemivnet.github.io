<%
  /* One recipe card as a web page. The data is the card's own (imported from
     the Typst source), so this mirrors the PDF: specs, then each step with the
     ingredients it uses beside the procedure, then swaps, notes and the
     nutrition table.

     Printing: the button prints the binder PDF itself (see the script at the
     end). Ctrl+P prints this page, which the @media print block in site.css
     lays out as a card: no site chrome, steps kept whole. */
  var r = recipe, rc = copy.recipes;
  var mass = function (g) { return g == null ? '' : (typeof g === 'number' ? g + ' g' : g); };
  var specs = [
    [rc.spec.yield, r.yield], [rc.spec.active, r.active], [rc.spec.total, r.total], [rc.spec.oven, r.oven],
    [r.servings === 1 ? rc.spec.per_batch : rc.spec.per_serving, r.perServing],
  ].filter(function (s) { return s[1]; });
  var stepNo = 0;
%>
<div class="musings-layout">
  <%~ include('_rail', { copy: copy, rail: rail, escapeHtml: escapeHtml }) %>

  <div class="musings-main">
    <header class="sp-post-header rc-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">~</a><span class="sep">/</span><a href="/recipes"><%= rc.post.crumbs_root %></a><span class="sep">/</span><a href="/recipes/<%= r.categorySlug %>"><%= escapeHtml(r.category) %></a>
      </nav>
      <h1><%= escapeHtml(r.title) %></h1>
      <% if (r.source) { %><p class="subtitle rc-source"><%= rc.spec.source %>: <%~ r.source %></p><% } %>
      <div class="rc-actions">
        <a class="sp-btn primary" href="<%= r.url %>/print" data-print-pdf="<%= r.pdfUrl %>"><%= rc.post.print_label %></a>
        <a class="sp-btn" href="<%= r.pdfUrl %>" download><%= rc.post.pdf_label %></a>
        <span class="rc-dim"><%= pagesLabel %><% if (r.revised) { %> · <%= rc.spec.revised %> <%= r.revised %><% } %></span>
      </div>
    </header>

    <dl class="rc-specs">
      <% specs.forEach(function(s){ %><div><dt><%= s[0] %></dt><dd><%~ s[1] %></dd></div><% }) %>
      <% if (r.equipment.length) { %><div class="rc-wide"><dt><%= rc.spec.equipment %></dt><dd><%~ r.equipment.join(' <span class="rc-sep">·</span> ') %></dd></div><% } %>
    </dl>

    <ol class="rc-steps">
      <% r.items.forEach(function(it){ %>
        <% if (it.kind === 'stage') { %>
          <li class="rc-stage"><%~ it.name %></li>
        <% } else { stepNo++; %>
          <li class="rc-step<%= it.ings.length ? '' : ' no-ings' %>">
            <span class="rc-num"><%= stepNo %></span>
            <% if (it.ings.length) { %>
            <table class="rc-ings">
              <% it.ings.forEach(function(i){ %>
                <tr>
                  <td class="rc-ing-name"><%~ i.name %><% if (i.note) { %><span class="rc-note">, <%~ i.note %></span><% } %></td>
                  <td class="rc-ing-g"><%~ mass(i.g) %></td>
                  <td class="rc-ing-vol"><%~ i.vol || '' %></td>
                </tr>
              <% }) %>
            </table>
            <% } %>
            <div class="rc-proc"><%~ it.body %></div>
          </li>
        <% } %>
      <% }) %>
    </ol>

    <% if (r.swaps) { %>
    <section class="rc-block">
      <h2 class="rc-h"><%= rc.swaps_tag %></h2>
      <div class="rc-table-wrap"><table class="rc-table">
        <tr><th><%~ r.swaps.header[0] %></th><th><%~ r.swaps.header[1] %></th></tr>
        <% r.swaps.rows.forEach(function(row){ %>
          <tr><td><%~ row.original %></td><td><% row.alts.forEach(function(a, n){ %><% if (n) { %><span class="rc-sep"> · </span><% } %><span class="rc-alt"><b><%= n + 1 %></b> <%~ a %></span><% }) %></td></tr>
        <% }) %>
      </table></div>
    </section>
    <% } %>

    <% if (r.notes.length) { %>
    <section class="rc-block">
      <h2 class="rc-h"><%= rc.notes_tag %></h2>
      <ul class="rc-notes"><% r.notes.forEach(function(n){ %><li><%~ n %></li><% }) %></ul>
    </section>
    <% } %>

    <% if (r.nutrition) { var nu = r.nutrition; %>
    <section class="rc-block">
      <h2 class="rc-h"><%= rc.nutrition.tag %></h2>
      <div class="rc-table-wrap"><table class="rc-table rc-nutrition">
        <tr><th></th><th class="num"><%= rc.nutrition.mass %></th><% nu.used.forEach(function(k){ %><th class="num"><%= rc.nutrition.columns[k] %></th><% }) %></tr>
        <% nu.rows.forEach(function(x){ %>
          <tr><td><%~ x.name %><% if (x.note) { %><span class="rc-note">, <%~ x.note %></span><% } %></td><td class="num"><%~ mass(x.g) %></td><% x.values.forEach(function(v){ %><td class="num"><%= v %></td><% }) %></tr>
        <% }) %>
        <tr class="rc-total rc-total-first"><td><%= rc.nutrition.total %></td><td></td><% nu.totals.forEach(function(v){ %><td class="num"><%= v %></td><% }) %></tr>
        <% if (nu.per) { %><tr class="rc-total"><td><%= rc.nutrition.per_serving.replace('{n}', r.servings) %></td><td></td><% nu.per.forEach(function(v){ %><td class="num"><%= v %></td><% }) %></tr><% } %>
      </table></div>
      <% if (r.nutritionSource) { %><p class="rc-caption"><%= rc.nutrition.source_prefix %> <%~ r.nutritionSource %></p><% } %>
    </section>
    <% } %>

    <p class="rc-print-url"><%= absUrl(r.url).replace(/^https?:\/\//, '') %></p>

    <%~ include('_recipe-disclaimer', { copy: copy }) %>

    <div class="sp-backlink">
      <a href="/recipes"><%= rc.post.back_label %></a>
    </div>
  </div>
</div>

<script>
(function () {
  // Print the binder PDF without leaving the page: load it into an off-screen
  // frame and call print() on that. Same-origin, so Chrome, Edge and Firefox
  // allow it. Where they don't (iOS Safari), fall through to the print page.
  var btn = document.querySelector('[data-print-pdf]');
  if (!btn) return;
  var label = btn.textContent, frame = null;
  btn.addEventListener('click', function (e) {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
    if (/iP(hone|ad|od)/.test(navigator.userAgent)) return;
    e.preventDefault();
    var go = function () {
      try { frame.contentWindow.focus(); frame.contentWindow.print(); }
      catch (_) { window.location.href = btn.getAttribute('href'); }
      btn.textContent = label;
    };
    if (frame) { go(); return; }
    btn.textContent = <%~ JSON.stringify(rc.post.print_working) %>;
    frame = document.createElement('iframe');
    frame.className = 'rc-print-frame-hidden';
    frame.setAttribute('aria-hidden', 'true');
    frame.tabIndex = -1;
    frame.src = btn.getAttribute('data-print-pdf');
    frame.onload = function () { setTimeout(go, 400); };
    document.body.appendChild(frame);
  });
})();
</script>
