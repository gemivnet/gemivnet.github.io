<div class="musings-layout">
  <aside class="musings-tree" aria-label="FOIA archive">
    <input type="checkbox" id="tree-toggle" class="tree-toggle">
    <label class="tree-head" for="tree-toggle"><%= copy.ui.sidebar_browse %></label>
    <%~ treeHtml %>
  </aside>

  <div class="musings-main">
    <header class="sp-post-header">
      <div class="crumbs">
        <a href="/">~</a> &nbsp;/&nbsp; <a href="/foia"><%= copy.foia.request.crumbs_root %></a>
        &nbsp;/&nbsp; <a href="<%= req.url %>"><%= req.slug %></a>
        &nbsp;/&nbsp; <span style="color: var(--ink-2);"><%= ev.id %></span>
      </div>
      <h1><%= ev.title %></h1>
    </header>

    <div class="foia-meta">
      <b><%= fmtLongDate(ev.date) %></b><span class="sep">·</span><%= ev.typeLabel %>
      <% if (ev.trackLabel) { %><span class="sep">·</span><%= ev.trackLabel %><% } %>
      <span class="sep">·</span><%= req.agencyShort %>
      <br>
      <b><%= ev.files.length %></b> file<%= ev.files.length === 1 ? '' : 's' %><% if (ev.pageCount) { %><span class="sep">·</span><b><%= ev.pageCount.toLocaleString() %></b> pages<% } %><% if (ev.byteCountFmt) { %><span class="sep">·</span><%= ev.byteCountFmt %><% } %>
      <% if (ev.exemptions.length) { %><span class="sep">·</span><%= copy.foia.labels.exemptions %> <%= ev.exemptions.join(', ') %><% } %>
      <% if (ev.note) { %><span class="fee-note"><%= ev.note %></span><% } %>
    </div>

    <table class="foia-files">
      <tbody>
        <% ;(ev.files).forEach(function(d){ %>
          <tr>
            <th scope="row">
              <a href="<%= d.url %>"><%= d.title %></a>
              <span class="sub"><%= d.file %><% if (d.sha256) { %> · sha256 <%= d.sha256.slice(0, 12) %>…<% } %></span>
            </th>
            <td>
              <% if (d.pages) { %><%= d.pages.toLocaleString() %> pp · <% } %><%= d.bytesFmt %>
              <br><a href="<%= d.src %>" download="<%= escapeHtml(d.file) %>"><%= copy.foia.release.download_one %></a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (ev.zip) { %>
      <p class="foia-dl">
        <a href="<%= ev.zip.src %>" download><%= copy.foia.release.download_all %><% if (ev.zip.bytesFmt) { %> · <%= ev.zip.bytesFmt %><% } %></a>
        <% if (ev.zip.sha256) { %><span>sha256 <%= ev.zip.sha256.slice(0, 12) %>…</span><% } %>
      </p>
    <% } %>

    <nav class="sp-postnav" aria-label="Release navigation">
      <div class="prev">
        <span class="label"><%= copy.foia.document.prev_label %></span>
        <% if (prev) { %><a href="<%= prev.url %>"><%= prev.title %></a>
        <% } else { %><span style="color: var(--ink-3);">(first release)</span><% } %>
      </div>
      <div class="next">
        <span class="label"><%= copy.foia.document.next_label %></span>
        <% if (next) { %><a href="<%= next.url %>"><%= next.title %></a>
        <% } else { %><span style="color: var(--ink-3);">(latest release)</span><% } %>
      </div>
    </nav>

    <div class="sp-backlink">
      <a href="<%= req.url %>">↑ <%= req.title %></a>
    </div>
  </div>
</div>
