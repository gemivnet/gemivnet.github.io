<div class="musings-layout">
  <%~ include('_rail', { copy: copy, rail: rail, escapeHtml: escapeHtml }) %>

  <div class="musings-main">
    <header class="sp-post-header">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">~</a><span class="sep">/</span><a href="/foia"><%= copy.foia.request.crumbs_root %></a><span class="sep">/</span><a href="<%= req.url %>"><%= req.slug %></a><span class="sep">/</span><span class="here" aria-current="page"><%= ev.id %></span>
      </nav>
      <h1><%= ev.title %></h1>
    </header>

    <% var FL = copy.foia.labels; %>
    <dl class="facts">
      <dt><%= FL.date %></dt><dd><%= fmtLongDate(ev.date) %></dd>
      <dt><%= FL.type %></dt><dd><%= ev.typeLabel %></dd>
      <% if (ev.trackLabel) { %><dt><%= FL.track %></dt><dd><%= ev.trackLabel %></dd><% } %>
      <dt><%= FL.agency %></dt><dd><%= req.agencyShort %></dd>
      <dt><%= FL.files %></dt><dd><%= ev.files.length %><% if (ev.pageCount) { %><span class="sep">·</span><%= ev.pageCount.toLocaleString() %> <%= copy.ui.pages %><% } %><% if (ev.byteCountFmt) { %><span class="sep">·</span><%= ev.byteCountFmt %><% } %></dd>
      <% if (ev.exemptions.length) { %><dt><%= FL.exemptions %></dt><dd><%= ev.exemptions.join(', ') %></dd><% } %>
    </dl>
    <% if (ev.note) { %><p class="fee-note"><%= ev.note %></p><% } %>

    <table class="foia-files">
      <tbody>
        <% ;(ev.files).forEach(function(d){ %>
          <tr>
            <th scope="row">
              <a href="<%= d.url %>"><%= d.title %></a>
              <span class="sub"><%= d.file %><% if (d.sha256) { %> · sha256 <%= d.sha256.slice(0, 12) %>…<% } %></span>
            </th>
            <td>
              <% if (d.pages) { %><%= d.pages.toLocaleString() %> <%= copy.ui.pages_abbr %> · <% } %><%= d.bytesFmt %>
              <br><a href="<%= d.src %>" download="<%= escapeHtml(d.file) %>"><%= copy.foia.release.download_one %></a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (ev.zip) { %>
      <p class="foia-dl">
        <a href="<%= ev.zip.src %>" download><%= copy.foia.release.download_all %><% if (ev.zip.bytesFmt) { %> · <%= ev.zip.bytesFmt %><% } %></a>
        <% if (ev.zip.sha256) { %><span>sha256 <%= ev.zip.sha256.slice(0, 12) %>…</span><% } %>
      </p>
    <% } %>

    <nav class="sp-postnav" aria-label="Release navigation">
      <div class="prev">
        <span class="label"><%= copy.foia.document.prev_label %></span>
        <% if (prev) { %><a href="<%= prev.url %>"><%= prev.title %></a>
        <% } else { %><span class="none"><%= copy.foia.release.first_note %></span><% } %>
      </div>
      <div class="next">
        <span class="label"><%= copy.foia.document.next_label %></span>
        <% if (next) { %><a href="<%= next.url %>"><%= next.title %></a>
        <% } else { %><span class="none"><%= copy.foia.release.latest_note %></span><% } %>
      </div>
    </nav>

    <div class="sp-backlink">
      <a href="<%= req.url %>">↑ <%= req.title %></a>
    </div>
  </div>
</div>
