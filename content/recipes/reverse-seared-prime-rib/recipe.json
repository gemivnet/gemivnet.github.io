    {
      "kind": "step",
      "ings": [],
      "body": "Preheat oven to its lowest setting, <span class=\"rc-nw\">150–250 °F</span>. Roast fat side up on the rack until the center hits the pull temp below. At <span class=\"rc-nw\">150 °F <span class=\"rc-muted\">(66 °C)</span></span>: <span class=\"rc-nw\">5½–6½ h</span>. At <span class=\"rc-nw\">250 °F <span class=\"rc-muted\">(121 °C)</span></span>: <span class=\"rc-nw\">3½–4 h</span>."
    },
    {
      "kind": "step",
      "ings": [],
      "body": "Tent with foil and rest in a warm spot, <span class=\"rc-nw\">30 min–1½ h</span>. Meanwhile, preheat oven to its highest setting, <span class=\"rc-nw\">500–550 °F</span>."
    },
    {
      "kind": "step",
      "ings": [],
      "body": "10 min before serving: uncover and return to the oven until well browned and crisp, <span class=\"rc-nw\">6–10 min</span>. Carve right away. No second rest."
    }
  ],
